---
import './LavaBackground.css';
---

<canvas class="lava" aria-hidden="true" data-lava></canvas>

<script>
  // Lava lamp en temps réel, sans boucle : une vidéo repasserait au début, ici chaque image est calculée à partir
  // du temps. Le mouvement suit le cycle d'une vraie lampe : une nappe de cire chaude en bas, d'où une goutte se
  // détache, s'étire en larme en montant, s'aplatit en haut, se refroidit et redescend pour se refondre dans la nappe.
  // Chaque goutte a sa période, et son point de départ comme sa hauteur changent à chaque cycle : la composition
  // ne se répète pas de façon lisible. La pellicule (grain à 24 images/s, léger tremblé, vignette) et le passage de flou
  // arrivent à une cadence de montage.
  // Avec « réduire les animations » : une seule image fixe, sans boucle.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-lava]');
  const zone = canvas?.parentElement;
  if (canvas && zone) {
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' });
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const vert = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}';
    const frag = `
precision highp float;
uniform vec2 uRes;
uniform float uView;   // hauteur de l'écran visible, en pixels du canvas : la lave se joue dans ce cadre
uniform float uT;
uniform float uBlur;   // passage de flou d'objectif (0 à 1)
uniform float uCount; // nombre d'emplacements utilisés (16 sur grand écran, 20 sur écran étroit)
uniform vec4 uBall[20]; // x, y, rayon, étirement vertical (>1 : goutte en larme, <1 : écrasée)
uniform vec3 uBC[20];   // couleur de chaque goutte
uniform sampler2D uSim; // surface de l'eau (hauteur, vitesse), dans le repère de la lave
uniform vec2 uSimD;     // un texel de cette surface
uniform float uSimOn;


float hash(vec2 p){vec3 q=fract(vec3(p.xyx)*0.1031);q+=dot(q,q.yzx+33.33);return fract((q.x+q.y)*q.z);}

// champ de la matière : somme des r²/d², plus c'est grand plus on est au coeur de la cire
float field(vec2 p){
  float f=0.;
  for(int i=0;i<20;i++){
    if(float(i)>=uCount) break;
    vec2 d=p-uBall[i].xy;
    d.y/=uBall[i].w;
    f+=uBall[i].z*uBall[i].z/(dot(d,d)+0.0004);
  }
  return f;
}

vec3 lava(vec2 p,float soft,out float m){
  float f=0.;
  vec3 c=vec3(0.);
  float wsum=0.;
  for(int i=0;i<20;i++){
    if(float(i)>=uCount) break;
    vec2 d=p-uBall[i].xy;
    d.y/=uBall[i].w;
    float w=uBall[i].z*uBall[i].z/(dot(d,d)+0.0004);
    f+=w;
    w*=sqrt(sqrt(sqrt(w)));
    c+=uBC[i]*w;
    wsum+=w;
  }
  c/=max(wsum,1e-4);
  m=smoothstep(1.0-soft,1.0+soft+0.12,f);
  return c;
}

void main(){
  float A=uRes.x/uView;
  // y = 1 en haut de l'écran, 0 au pli (là où se tient la nappe), négatif sous le pli
  vec2 uv=vec2(gl_FragCoord.x,gl_FragCoord.y-(uRes.y-uView))/uView;
  float t=uT;

  // courbure du verre : on regarde la lave à travers une paroi bombée. Le centre est légèrement agrandi, les côtés se
  // compriment et se courbent (le contenu y défile plus vite), comme au bord d'un cylindre de verre.
  // sur un écran étroit (portrait), la paroi est presque plate : la courbure et ses effets de bord sont atténués (c = 1 sur grand écran)
  float c=mix(1.,0.28,clamp((1.-A)/0.4,0.,1.));
  vec2 sn=vec2(uv.x/A,uv.y)*2.-1.;
  float edge=pow(abs(sn.x),3.)*c;
  vec2 warped=vec2(sn.x*(1.+0.46*c*sn.x*sn.x),sn.y*(1.+0.12*c*sn.x*sn.x)+0.08*c*sn.x*sn.x*sn.x*sn.y);
  uv=vec2((warped.x*.5+.5)*A,warped.y*.5+.5);

  // tremblé de la fenêtre de projection : un décalage minuscule, tiré à 24 images/s
  float fr=floor(t*24.);
  uv+=(vec2(hash(vec2(fr,1.)),hash(vec2(fr,2.)))-0.5)*0.0003;

  // surface de l'eau : l'onde simulée dévie ce qu'on voit à travers elle (réfraction), accroche la lumière (reflet) et la
  // concentre en filets clairs (caustiques) là où elle se creuse
  float sLap=0.,sSpec=0.;
  if(uSimOn>0.5){
    vec2 ss=vec2(uv.x/A,(uv.y*uView+uRes.y-uView)/uRes.y);
    float hc=texture2D(uSim,ss).r;
    float hx1=texture2D(uSim,ss+vec2(uSimD.x*2.,0.)).r;
    float hx0=texture2D(uSim,ss-vec2(uSimD.x*2.,0.)).r;
    float hy1=texture2D(uSim,ss+vec2(0.,uSimD.y*2.)).r;
    float hy0=texture2D(uSim,ss-vec2(0.,uSimD.y*2.)).r;
    vec2 sg=vec2(hx1-hx0,hy1-hy0)*0.5;
    sLap=hx1+hx0+hy1+hy0-4.*hc;
    uv+=clamp(sg*0.8,-0.01,0.01);
    vec3 sn3=normalize(vec3(-sg*14.,1.));
    vec3 hv=normalize(normalize(vec3(-0.45,0.6,0.66))+vec3(0.,0.,1.));
    sSpec=pow(max(dot(sn3,hv),0.),110.);
  }

  float soft=0.085+uBlur*0.55;
  float shift=0.0022*uBlur+0.013*edge;
  float m,mr,mb;
  vec3 col=lava(uv,soft,m);
  // dispersion chromatique pendant les passages de flou et sur les bords du verre
  vec3 colR=col,colB=col;
  if(shift>0.0004){
    colR=lava(uv+vec2(shift,0.),soft,mr);
    colB=lava(uv-vec2(shift,0.),soft,mb);
  } else { mr=m; mb=m; }

  // papier : clair, légèrement bleuté à gauche et mentholé à droite comme le mesh de la marque
  vec3 paper=mix(vec3(0.9,0.925,0.968),vec3(0.9,0.962,0.95),clamp(uv.x/A,0.,1.));
  paper=mix(paper,vec3(0.84,0.945,0.92),smoothstep(0.55,1.,uv.x/A)*smoothstep(0.55,0.,uv.y)*0.5);
  // une brume lavande très légère en haut à gauche : le prolongement du bleu dans le spectre
  paper=mix(paper,vec3(0.925,0.9,0.975),smoothstep(0.7,0.,uv.x/A)*smoothstep(0.35,1.,uv.y)*0.35);

  // la lave est tirée vers le papier pour rester pastel, et elle s'efface derrière le bloc de texte (lisibilité)
  vec2 q=(uv-vec2(A*0.5,0.52))/vec2(max(A*0.3,0.5),0.34);
  float textZone=exp(-dot(q,q));
  float strength=0.92-0.55*textZone;
  vec3 tint=vec3(1.0,0.99,0.97);
  vec3 lavaCol=mix(col,tint,0.04);
  vec3 outC;
  outC.r=mix(paper.r,mix(colR,tint,0.04).r,mr*strength);
  outC.g=mix(paper.g,lavaCol.g,m*strength);
  outC.b=mix(paper.b,mix(colB,tint,0.04).b,mb*strength);

  // relief : un éclairage rasant sur le bord des gouttes (arête claire en haut à gauche, ombre douce en bas à droite)
  float e=0.004;
  vec2 g=vec2(field(uv+vec2(e,0.))-field(uv-vec2(e,0.)),field(uv+vec2(0.,e))-field(uv-vec2(0.,e)));
  float gm=length(g);
  vec2 n=-g/max(gm,1e-5);
  float rim=m*(1.-m)*4.*smoothstep(0.015,0.09,gm);
  float lit=dot(n,normalize(vec2(-0.6,0.8)));
  outC+=vec3(1.)*max(lit,0.)*rim*0.22*(1.-uBlur);
  outC-=vec3(0.18,0.2,0.16)*max(-lit,0.)*rim*0.12*(1.-uBlur);
  if(uSimOn>0.5){
    outC+=vec3(1.)*sSpec*0.85;
    outC+=vec3(0.8,0.92,1.)*clamp(-sLap*16.,0.,1.)*0.38;
    outC-=vec3(0.1,0.13,0.16)*clamp(sLap*16.,0.,1.)*0.14;
  }

  // dispersion du verre sur les côtés : frange rouge-orangé vers l'intérieur, froide vers l'extérieur
  float fringe=smoothstep(0.45,1.,abs(sn.x));
  outC+=vec3(0.07,0.0,-0.03)*fringe*fringe*(1.-uBlur)*c;
  outC=mix(outC,outC*vec3(1.0,0.97,1.04),fringe*0.5*c);

  // parois du verre : un reflet vertical doux à gauche, une ombre fine contre chaque bord
  float streak=exp(-pow((sn.x+0.8)/0.035,2.));
  outC+=vec3(0.06)*streak*(0.6+0.4*sin(uv.y*3.+t*0.05))*c;
  outC=mix(outC,outC*vec3(0.84,0.84,0.86),smoothstep(0.78,1.,abs(sn.x))*0.7*c);
  outC+=vec3(0.05)*exp(-pow((sn.x-0.86)/0.05,2.))*c;

  // pellicule : grain à 24 images/s (plus marqué dans les ombres), vignette douce, léger voile chaud
  float gr=hash(gl_FragCoord.xy*0.8+fr*7.31)-0.5;
  float lum=dot(outC,vec3(0.299,0.587,0.114));
  outC+=gr*(0.052-0.02*lum);
  vec2 vq=gl_FragCoord.xy/uRes-0.5;
  outC*=1.-dot(vq,vq)*0.38;
  outC=mix(outC,outC*vec3(0.99,1.0,1.02),0.5);

  outC=clamp(outC,0.,1.);
  gl_FragColor=vec4(clamp(outC,0.,1.),1.);
}`;

    const compile = (type: number, src: string) => {
      const s = gl!.createShader(type)!;
      gl!.shaderSource(s, src);
      gl!.compileShader(s);
      return gl!.getShaderParameter(s, gl!.COMPILE_STATUS) ? s : null;
    };

    const vs = gl && compile(gl.VERTEX_SHADER, vert);
    const fs = gl && compile(gl.FRAGMENT_SHADER, frag);

    if (gl && vs && fs) {
      const prog = gl.createProgram()!;
      gl.attachShader(prog, vs);
      gl.attachShader(prog, fs);
      gl.linkProgram(prog);
      gl.useProgram(prog);

      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'a');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

      const U = (n: string) => gl.getUniformLocation(prog, n);
      const uRes = U('uRes'), uView = U('uView'), uT = U('uT'), uBlur = U('uBlur'), uBall = U('uBall'), uBC = U('uBC'), uCount = U('uCount');

      const uSimTex = U('uSim'), uSimD = U('uSimD'), uSimOn = U('uSimOn');

      type Col = [number, number, number];
      // spectre bleu serré : bleu marine, bleu klein, bleu roi, puis bleu-vert (canard, lagon). Les mélanges passent d'une
      // teinte à l'autre sans jamais sortir de cette famille.
      const navy: Col = [0.09, 0.17, 0.52];
      const klein: Col = [0.12, 0.27, 0.84];
      const royal: Col = [0.22, 0.42, 0.92];
      const teal: Col = [0.1, 0.48, 0.82];
      const lagoon: Col = [0.12, 0.58, 0.75];
      // le prolongement du bleu dans le spectre : un violet, puis une pointe de rose. Seulement deux petites gouttes, pour la nuance.
      const violet: Col = [0.42, 0.3, 0.88];
      const orchid: Col = [0.62, 0.36, 0.86];

      // La nappe du bas (3 grosses gouttes aplaties) : la cire chaude d'où tout part.
      const pool = [
        { x: 0.18, r: 0.16, c: navy },
        { x: 0.5, r: 0.19, c: klein },
        { x: 0.82, r: 0.16, c: teal },
      ];
      // Les gouttes mobiles. per = durée d'un cycle complet en secondes, off = avance du cycle au départ, top = hauteur
      // maximale (1 = haut de l'écran). Les 4 premières sont grosses, les 6 suivantes petites ; tail = traîne en larme.
      const drops = [
        { r: 0.125, per: 96, off: 0.58, top: 0.92, c: navy, tail: true, sway: 0.035, sf: 0.11, seed: 1 },
        { r: 0.11, per: 118, off: 0.2, top: 0.84, c: klein, tail: true, sway: 0.04, sf: 0.09, seed: 2 },
        { r: 0.12, per: 83, off: 0.8, top: 0.96, c: teal, tail: true, sway: 0.03, sf: 0.13, seed: 3 },
        { r: 0.1, per: 132, off: 0.38, top: 0.78, c: lagoon, tail: false, sway: 0.045, sf: 0.08, seed: 4 },
        { r: 0.05, per: 41, off: 0.1, top: 0.7, c: violet, tail: false, sway: 0.03, sf: 0.17, seed: 5 },
        { r: 0.04, per: 53, off: 0.55, top: 0.85, c: klein, tail: false, sway: 0.035, sf: 0.14, seed: 6 },
        { r: 0.055, per: 47, off: 0.32, top: 0.55, c: teal, tail: false, sway: 0.03, sf: 0.19, seed: 7 },
        { r: 0.04, per: 61, off: 0.7, top: 0.92, c: orchid, tail: false, sway: 0.04, sf: 0.12, seed: 8 },
        { r: 0.06, per: 37, off: 0.88, top: 0.62, c: royal, tail: false, sway: 0.025, sf: 0.21, seed: 9 },
        { r: 0.045, per: 57, off: 0.45, top: 0.76, c: lagoon, tail: false, sway: 0.035, sf: 0.16, seed: 10 },
        // 4 gouttes de plus, lues seulement sur écran étroit (portrait) : la lave y paraît moins clairsemée
        { r: 0.055, per: 44, off: 0.62, top: 0.9, c: klein, tail: false, sway: 0.03, sf: 0.15, seed: 11 },
        { r: 0.05, per: 58, off: 0.27, top: 0.7, c: lagoon, tail: false, sway: 0.035, sf: 0.18, seed: 12 },
        { r: 0.06, per: 39, off: 0.9, top: 0.85, c: royal, tail: false, sway: 0.03, sf: 0.2, seed: 13 },
        { r: 0.045, per: 67, off: 0.5, top: 0.6, c: violet, tail: false, sway: 0.03, sf: 0.13, seed: 14 },
      ];
      const MAIN = 10;
      const POOL = 3;
      const HEADS = POOL;
      const TAILS = POOL + MAIN;
      const NT = drops.filter((d) => d.tail).length;
      // emplacement d'une goutte : têtes (3 à 12), traînes (13 à 15), puis les gouttes supplémentaires (16 à 19)
      const slotOf = (i: number) => (i < MAIN ? HEADS + i : TAILS + NT + (i - MAIN));
      const colors = new Float32Array(20 * 3);
      const setCol = (slot: number, c: Col) => colors.set(c, slot * 3);
      pool.forEach((p, i) => setCol(i, p.c));
      drops.forEach((d, i) => setCol(slotOf(i), d.c));
      let tailSlot = TAILS;
      const tailOf: number[] = [];
      drops.forEach((d, i) => {
        if (d.tail) {
          tailOf[i] = tailSlot;
          setCol(tailSlot, d.c);
          tailSlot++;
        } else tailOf[i] = -1;
      });
      gl.uniform3fv(uBC, colors);

      const bd = new Float32Array(80);
      // temps propre à chaque goutte : il avance un peu plus vite juste après un contact, puis retrouve son rythme
      const tau = new Float32Array(drops.length);
      const boost = new Float32Array(drops.length);
      const prox = new Float32Array(drops.length);
      // élasticité : un ressort amorti par goutte (écart et vitesse), poussé quand elle touche une autre goutte
      const el = new Float32Array(drops.length);
      const elv = new Float32Array(drops.length);
      let lastT = -1;
      const SPEED = 0.2;
      let view = 1;
      let floorY = 0;
      // le canvas dépasse sous la Hero : la section suivante, en verre dépoli, laisse voir le bas des gouttes
      const EXTRA = 380;

      // ---- Surface de l'eau, comme dans « WebGL Water » d'Evan Wallace : une carte de hauteurs que l'équation d'onde fait vivre.
      // Chaque point accélère vers la moyenne de ses voisins (c'est ce qui fait se propager une onde), avec un peu de frottement.
      // Les gouttes qui bougent y laissent un sillage, les contacts et le choc d'ouverture y font des anneaux, le pointeur aussi.
      // La carte est stockée dans des textures à virgule flottante (deux, alternées) et calculée sur la carte graphique.
      // Sans cette capacité (vieux appareils), la lave reste telle quelle, sans surface d'eau.
      const SIM_VERT = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}';
      const SIM_FRAG = `
precision highp float;
uniform sampler2D uS;
uniform vec2 uD;
uniform float uA;
uniform float uYmin;
uniform float uCount;
uniform vec4 uBall[20];
uniform vec2 uMove[20];
uniform vec4 uPtr;
uniform vec2 uPtrV;
uniform vec4 uHit[4];
uniform float uInject;
void main(){
  vec2 s=gl_FragCoord.xy*uD;
  vec2 st=texture2D(uS,s).xy;
  float h=st.x,v=st.y;
  float avg=(texture2D(uS,s+vec2(uD.x,0.)).x+texture2D(uS,s-vec2(uD.x,0.)).x+texture2D(uS,s+vec2(0.,uD.y)).x+texture2D(uS,s-vec2(0.,uD.y)).x)*0.25;
  // (le coefficient est plus bas que dans l'original : avec des textures à demi-précision, le mode en damier à l'échelle du texel restait à la limite de la stabilité)
  v+=(avg-h)*0.4;
  v*=0.994;
  h+=v;
  h=mix(h,avg,0.06);
  h=clamp(h,-0.8,0.8);
  v=clamp(v,-0.12,0.12);
  // bords absorbants : l'onde s'y éteint au lieu de revenir
  vec2 e=min(s,1.-s);
  float ab=smoothstep(0.,0.06,min(e.x,e.y));
  h*=mix(0.9,1.,ab);
  v*=mix(0.9,1.,ab);
  if(uInject>0.5){
    vec2 p=vec2(s.x*uA,uYmin+s.y*(1.-uYmin));
    // sillage : devant une goutte qui avance l'eau monte, derrière elle elle descend
    for(int i=0;i<20;i++){
      if(float(i)>=uCount) break;
      vec2 d=p-uBall[i].xy;
      float r=uBall[i].z*2.+0.01;
      float dl=length(d);
      float k=exp(-dot(d,d)/(r*r))*smoothstep(0.,0.35*r,dl);
      v+=clamp(k*dot(uMove[i],d/max(dl,1e-4))*0.85,-0.013,0.013);
    }
    vec2 pd=p-uPtr.xy;
    float pr=uPtr.z;
    float pl=length(pd);
    v+=clamp(exp(-dot(pd,pd)/(pr*pr))*smoothstep(0.,0.35*pr,pl)*dot(uPtrV,pd/max(pl,1e-4))*uPtr.w*4.,-0.03,0.03);
    // impacts : un creux ou une bosse qui s'étale en anneau
    for(int j=0;j<4;j++){
      vec4 hh=uHit[j];
      float hd=length(p-hh.xy)/max(hh.z,1e-3);
      if(hd<1.&&hh.w!=0.) h+=(0.5+0.5*cos(hd*3.14159))*hh.w;
    }
  }
  gl_FragColor=vec4(h,v,0.,1.);
}`;

      type Sim = { tex: WebGLTexture[]; fbo: WebGLFramebuffer[]; w: number; h: number; cur: number };
      let sim: Sim | null = null;
      let simType = 0;
      let simLinear = false;
      let simProg: WebGLProgram | null = null;
      let sS: WebGLUniformLocation | null = null;
      let sD: WebGLUniformLocation | null = null;
      let sA: WebGLUniformLocation | null = null;
      let sYmin: WebGLUniformLocation | null = null;
      let sCount: WebGLUniformLocation | null = null;
      let sBall: WebGLUniformLocation | null = null;
      let sMove: WebGLUniformLocation | null = null;
      let sPtr: WebGLUniformLocation | null = null;
      let sPtrV: WebGLUniformLocation | null = null;
      let sHit: WebGLUniformLocation | null = null;
      let sInject: WebGLUniformLocation | null = null;
      const prevB = new Float32Array(80);
      const mv = new Float32Array(40);
      const hitBuf = new Float32Array(16);
      let hitN = 0;
      let simPrimed = false;
      const ptr = { x: 0, y: 0, vx: 0, vy: 0, on: 0 };
      // un impact : position, rayon (dans le repère de la lave) et hauteur (positive : bosse, négative : creux)
      const addHit = (x: number, y: number, rad: number, amount: number) => {
        if (hitN >= 4) return;
        hitBuf.set([x, y, rad, amount], hitN * 4);
        hitN++;
      };

      if (!calm) {
        const hf = gl.getExtension('OES_texture_half_float');
        const cbh = gl.getExtension('EXT_color_buffer_half_float');
        const hfl = gl.getExtension('OES_texture_half_float_linear');
        const ff = gl.getExtension('OES_texture_float');
        const cbf = gl.getExtension('WEBGL_color_buffer_float');
        const ffl = gl.getExtension('OES_texture_float_linear');
        if (hf && cbh && hfl) {
          simType = hf.HALF_FLOAT_OES;
          simLinear = true;
        } else if (ff && cbf) {
          simType = gl.FLOAT;
          simLinear = !!ffl;
        }
        const sv = compile(gl.VERTEX_SHADER, SIM_VERT);
        const sf = compile(gl.FRAGMENT_SHADER, SIM_FRAG);
        if (simType && sv && sf) {
          const p = gl.createProgram()!;
          gl.attachShader(p, sv);
          gl.attachShader(p, sf);
          gl.bindAttribLocation(p, 0, 'a');
          gl.linkProgram(p);
          if (gl.getProgramParameter(p, gl.LINK_STATUS)) {
            simProg = p;
            const SU = (n: string) => gl.getUniformLocation(p, n);
            sS = SU('uS');
            sD = SU('uD');
            sA = SU('uA');
            sYmin = SU('uYmin');
            sCount = SU('uCount');
            sBall = SU('uBall');
            sMove = SU('uMove');
            sPtr = SU('uPtr');
            sPtrV = SU('uPtrV');
            sHit = SU('uHit');
            sInject = SU('uInject');
            gl.enableVertexAttribArray(0);
            gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
          }
        }
      }

      const freeSim = () => {
        if (!sim) return;
        sim.tex.forEach((t) => gl.deleteTexture(t));
        sim.fbo.forEach((b) => gl.deleteFramebuffer(b));
        sim = null;
      };
      // la carte a la même forme que le canvas (un texel carré), environ 224 texels de haut
      const buildSim = (aspect: number) => {
        freeSim();
        gl.useProgram(prog);
        gl.uniform1f(uSimOn, 0);
        if (!simProg) return;
        const hh = 224;
        const ww = Math.max(64, Math.min(640, Math.round(hh * aspect)));
        const tex: WebGLTexture[] = [];
        const fbo: WebGLFramebuffer[] = [];
        let ok = true;
        gl.activeTexture(gl.TEXTURE1);
        for (let i = 0; i < 2; i++) {
          const t = gl.createTexture()!;
          gl.bindTexture(gl.TEXTURE_2D, t);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, simLinear ? gl.LINEAR : gl.NEAREST);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, simLinear ? gl.LINEAR : gl.NEAREST);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, ww, hh, 0, gl.RGBA, simType, null);
          const b = gl.createFramebuffer()!;
          gl.bindFramebuffer(gl.FRAMEBUFFER, b);
          gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, t, 0);
          if (gl.checkFramebufferStatus(gl.FRAMEBUFFER) !== gl.FRAMEBUFFER_COMPLETE) ok = false;
          gl.clearColor(0, 0, 0, 1);
          gl.clear(gl.COLOR_BUFFER_BIT);
          tex.push(t);
          fbo.push(b);
        }
        gl.bindFramebuffer(gl.FRAMEBUFFER, null);
        gl.viewport(0, 0, canvas.width, canvas.height);
        if (!ok) {
          tex.forEach((t) => gl.deleteTexture(t));
          fbo.forEach((b) => gl.deleteFramebuffer(b));
          simProg = null;
          return;
        }
        sim = { tex, fbo, w: ww, h: hh, cur: 0 };
        gl.bindTexture(gl.TEXTURE_2D, tex[0]);
        gl.uniform1i(uSimTex, 1);
        gl.uniform2f(uSimD, 1 / ww, 1 / hh);
        gl.uniform1f(uSimOn, 1);
        gl.useProgram(simProg);
        gl.uniform1i(sS, 1);
        gl.uniform2f(sD, 1 / ww, 1 / hh);
        gl.useProgram(prog);
        simPrimed = false;
      };

      // une image de la simulation : 3 pas (l'onde avance de 3 texels environ), les sources n'agissent qu'au premier
      const simFrame = (count: number, A: number, view_: number) => {
        const S = sim;
        if (!S || !simProg) return;
        for (let i = 0; i < 20; i++) {
          const on = i < count;
          mv[i * 2] = on ? Math.max(-0.05, Math.min(0.05, bd[i * 4] - prevB[i * 4])) : 0;
          mv[i * 2 + 1] = on ? Math.max(-0.05, Math.min(0.05, bd[i * 4 + 1] - prevB[i * 4 + 1])) : 0;
        }
        const ymin = (view_ - canvas.height) / view_;
        gl.useProgram(simProg);
        gl.uniform1f(sA, A);
        gl.uniform1f(sYmin, ymin);
        gl.uniform1f(sCount, count);
        gl.uniform4fv(sBall, bd);
        gl.uniform2fv(sMove, mv);
        gl.uniform4f(sPtr, ptr.x, ptr.y, 0.035, ptr.on);
        gl.uniform2f(sPtrV, ptr.vx, ptr.vy);
        gl.uniform4fv(sHit, hitBuf);
        gl.viewport(0, 0, S.w, S.h);
        gl.activeTexture(gl.TEXTURE1);
        for (let n = 0; n < 3; n++) {
          gl.bindTexture(gl.TEXTURE_2D, S.tex[S.cur]);
          gl.bindFramebuffer(gl.FRAMEBUFFER, S.fbo[1 - S.cur]);
          gl.uniform1f(sInject, n === 0 ? 1 : 0);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          S.cur = 1 - S.cur;
        }
        gl.bindFramebuffer(gl.FRAMEBUFFER, null);
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.useProgram(prog);
        gl.bindTexture(gl.TEXTURE_2D, S.tex[S.cur]);
        hitBuf.fill(0);
        hitN = 0;
        ptr.vx = 0;
        ptr.vy = 0;
        ptr.on = 0;
        prevB.set(bd);
      };

      const resize = () => {
        const w = zone.clientWidth || innerWidth;
        const h = (zone.clientHeight || innerHeight) + EXTRA;
        // définition fine (≈ 1 Mpx au plus) : une lave dessinée trop petite puis agrandie paraît pixélisée, le grain surtout
        let s = Math.min(1, 1500 / w) * Math.min(devicePixelRatio || 1, 1.5) * 0.85;
        s = Math.min(s, Math.sqrt(1.1e6 / (w * h)));
        canvas.width = Math.max(2, Math.round(w * s));
        canvas.height = Math.max(2, Math.round(h * s));
        view = Math.min(canvas.height, Math.round(innerHeight * s));
        // bas de la Hero, dans le repère de la lave (1 = haut de l'écran, 0 = bas de l'écran)
        floorY = 1 - (zone.clientHeight || innerHeight) / innerHeight;
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uRes, canvas.width, canvas.height);
        gl.uniform1f(uView, view);
        buildSim(canvas.width / canvas.height);
      };

      const smooth = (a: number, b: number, x: number) => {
        const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
        return t * t * (3 - 2 * t);
      };
      // un passage = une montée douce, un palier, une descente douce
      const pass = (t: number, period: number, offset: number, len: number) => {
        const ph = (((t + offset) % period) + period) % period;
        return smooth(0, len * 0.35, ph) * (1 - smooth(len * 0.65, len, ph));
      };
      const rnd = (n: number, seed: number) => {
        const v = Math.sin(n * 12.9898 + seed * 78.233) * 43758.5453;
        return v - Math.floor(v);
      };
      // profil d'un cycle (w de 0 à 1) : la goutte monte, reste un instant en haut, puis redescend plus doucement
      const H = (w: number) => smooth(0, 0.5, w) - smooth(0.62, 1, w);

      // Pendant le loader (écran d'arrivée simple, voir Loader), la lave tourne déjà derrière lui ; le titre ne prend son effet
      // négatif qu'une fois le loader parti.
      const root = document.documentElement;
      const loading = !calm && root.classList.contains('has-loader');
      const clamp01 = (x: number) => Math.min(1, Math.max(0, x));

      // voie de chaque goutte sur grand écran (0 = gauche, 1 = droite) : placées à la main pour que la masse de lave se répartisse
      // à égalité entre la gauche, le centre et la droite, les plus grosses réparties sur la largeur
      const LANES = [0.85, 0.5, 0.15, 0.62, 0.3, 0.75, 0.05, 0.95, 0.4, 0.7];
      // position, étirement et rayon d'une goutte pour une phase de cycle donnée
      const place = (d: (typeof drops)[number], phase: number, u: number, A: number) => {
        const narrow = A < 1;
        const n = Math.floor(phase);
        const w = phase - n;
        const top = d.top * (0.78 + 0.22 * rnd(n, d.seed));
        const base = floorY + 0.06;
        // écran étroit : chaque goutte évolue dans sa propre bande de hauteur (deuxième coordonnée de la suite R2), si bien
        // que l'ensemble couvre l'écran de façon homogène, au lieu de s'entasser en bas puis en haut
        const yc = base + 0.02 + (0.95 - base) * ((d.seed * 0.569840291) % 1);
        const y = narrow ? Math.min(0.97, Math.max(base, yc + 0.1 * (2 * H(w) - 1))) : base + (top - base) * H(w);
        // chaque goutte garde sa voie (suite de nombres bien répartis) et ne varie que d'un écart, pour que les bulles
        // s'étalent sur la largeur au lieu de s'amasser d'un côté
        const lane = (k: number) =>
          narrow
            ? (d.seed * 0.7548776662 + 0.1 * rnd(k, d.seed)) % 1
            : Math.min(1, Math.max(0, LANES[(d.seed - 1) % LANES.length] + 0.12 * (rnd(k, d.seed) - 0.5)));
        const lo = narrow ? 0.02 : 0.08;
        const sp = narrow ? 0.96 : 0.84;
        const x0 = A * (lo + sp * lane(n + 0.5));
        const x1 = A * (lo + sp * lane(n + 1.5));
        // le départ latéral se fait pendant la descente, quand la goutte est près de la nappe
        const x = x0 + (x1 - x0) * smooth(0.78, 1, w) + A * d.sway * Math.sin(u * d.sf + d.seed * 3.1);
        // taille propre à chaque cycle (0,85 à 1,2), fondue quand la goutte retourne dans la nappe
        const rv = 0.85 + 0.35 * (rnd(n + 3.3, d.seed) + (rnd(n + 4.3, d.seed) - rnd(n + 3.3, d.seed)) * smooth(0.78, 1, w));
        // vitesse verticale (0 à 1) : la goutte s'étire en larme quand elle file, s'écrase en palier
        const e = 0.01;
        const vn = Math.min(1, Math.abs(H(w + e) - H(w - e)) / (2 * e) / 3.4);
        return { x, y, s: 0.98 + 0.13 * vn, vn, rv };
      };

      const draw = (t: number) => {
        const A = canvas.width / view;
        const dt = lastT < 0 ? 0 : Math.min(0.1, Math.max(0, t - lastT));
        lastT = t;
        // rayons : sur un écran étroit (portrait), les gouttes rétrécissent davantage pour rester des bulles distinctes
        const rs = Math.min(1, 0.08 + 0.68 * A);
        const active = A < 1 ? drops.length : MAIN;

        pool.forEach((p, i) => {
          bd[i * 4] = (p.x + 0.035 * Math.sin(t * 0.05 + i * 1.9)) * A;
          bd[i * 4 + 1] = floorY + 0.03 + 0.012 * Math.sin(t * 0.13 + i * 2.1);
          bd[i * 4 + 2] = p.r * rs * (A < 1 ? 0.8 : 1) * (1 + 0.04 * Math.sin(t * 0.09 + i));
          bd[i * 4 + 3] = 0.9;
        });

        drops.forEach((d, i) => {
          if (i >= active) return;
          // la phase avance au temps réel ralenti, plus un surplus quand la goutte vient d'en toucher une autre
          tau[i] += dt * SPEED * (1 + boost[i]) * (1 + 0.25 * Math.sin(t * 0.05 * (1 + i * 0.13) + d.seed * 2.3));
          if (dt === 0 && tau[i] === 0) tau[i] = t * SPEED;
          const u = tau[i];
          const p = place(d, u / d.per + d.off, u, A);
          const k = slotOf(i) * 4;
          bd[k] = p.x;
          bd[k + 1] = p.y;
          bd[k + 2] = d.r * rs * p.rv * (1.04 - 0.08 * p.vn);
          bd[k + 3] = p.s;
          if (tailOf[i] >= 0) {
            // la traîne suit la tête avec un léger retard : c'est elle qui fait le col étroit de la larme
            const lag = 0.05;
            const q = place(d, u / d.per + d.off - lag, u - lag * d.per, A);
            const j = tailOf[i] * 4;
            bd[j] = q.x;
            bd[j + 1] = q.y;
            bd[j + 2] = d.r * rs * q.rv * 0.52;
            bd[j + 3] = 1.04;
          }
        });

        // contacts : la proximité de chaque goutte avec les autres gouttes ; quand elle monte, petit élan
        drops.forEach((_, i) => {
          if (i >= active) return;
          const a = slotOf(i) * 4;
          let p = 0;
          for (let jj = 0; jj < active; jj++) {
            if (jj === i) continue;
            const b = slotOf(jj) * 4;
            const reach = (bd[a + 2] + bd[b + 2]) * 1.2;
            const dist = Math.hypot(bd[a] - bd[b], (bd[a + 1] - bd[b + 1]) * 0.8);
            const q = Math.min(1, Math.max(0, (reach - dist) / (reach * 0.5)));
            p = Math.max(p, q * q * (3 - 2 * q));
          }
          if (p > prox[i]) {
            boost[i] = Math.min(0.5, boost[i] + (p - prox[i]) * 1.0);
            elv[i] += (p - prox[i]) * 2.4;
            addHit(bd[a], bd[a + 1], bd[a + 2] * 1.7, (p - prox[i]) * 0.75);
          }
          prox[i] = p;
          boost[i] *= Math.exp(-dt * 0.35);
        });

        // ressort : écrase la goutte (plus large, plus basse) puis la détend (plus étroite, plus haute), et le battement s'éteint
        for (let i = 0; i < active; i++) {
          elv[i] += (-34 * el[i] - 4.6 * elv[i]) * dt;
          el[i] = Math.max(-1.2, Math.min(1.2, el[i] + elv[i] * dt));
          const k = slotOf(i) * 4;
          bd[k + 2] *= 1 + 0.07 * el[i];
          bd[k + 3] *= 1 - 0.1 * el[i];
        }
        const count = TAILS + NT + (active - MAIN);
        if (sim) {
          if (!simPrimed) {
            prevB.set(bd);
            simPrimed = true;
          }
          simFrame(count, A, view);
        }
        gl.uniform1f(uCount, count);
        gl.uniform4fv(uBall, bd);
        gl.uniform1f(uT, t);
        gl.uniform1f(uBlur, pass(t, 43, 17, 10) * 0.42);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      };

      // le pointeur laisse un sillage (position convertie dans le repère de la lave, en défaisant la courbure du verre)
      /* sillage du pointeur : désactivé pour l'instant
      if (!calm) {
        let lastX = NaN;
        let lastY = NaN;
        window.addEventListener(
          'pointermove',
          (e) => {
            if (!sim || e.pointerType === 'touch' || root.classList.contains('has-loader')) return;
            const rect = canvas.getBoundingClientRect();
            if (e.clientY < rect.top || e.clientY > rect.top + (zone.clientHeight || innerHeight) || rect.width < 2) return;
            const k = canvas.height / rect.height;
            const fx = (e.clientX - rect.left) / rect.width;
            const uy = ((rect.bottom - e.clientY) * k - (canvas.height - view)) / view;
            const sx = fx * 2 - 1;
            const sy = uy * 2 - 1;
            const wx = sx * (1 + 0.46 * sx * sx);
            const wy = sy * (1 + 0.12 * sx * sx) + 0.08 * sx * sx * sx * sy;
            const Ar = canvas.width / view;
            const lx = (wx * 0.5 + 0.5) * Ar;
            const ly = wy * 0.5 + 0.5;
            if (Number.isFinite(lastX)) {
              ptr.vx += Math.max(-0.05, Math.min(0.05, lx - lastX));
              ptr.vy += Math.max(-0.05, Math.min(0.05, ly - lastY));
            }
            lastX = lx;
            lastY = ly;
            ptr.x = lx;
            ptr.y = ly;
            ptr.on = 1;
          },
          { passive: true },
        );
      }
      */

      resize();
      new ResizeObserver(() => {
        resize();
        if (calm) draw(14);
      }).observe(zone);

      let raf = 0;
      let visible = true;
      let origin = performance.now();
      const loop = (now: number) => {
        raf = 0;
        if (!visible) return;
        draw(14 + (now - origin) / 1000);
        raf = requestAnimationFrame(loop);
      };

      if (calm) {
        draw(14);
        canvas.classList.add('is-ready');
        zone.classList.add('neg-on');
      } else {
        draw(14);
        requestAnimationFrame(() => canvas.classList.add('is-ready'));
        // le négatif du titre s'active tout de suite, en même temps que le fondu de la lave : le mélange et les teintes
        // complémentaires arrivent ensemble, sans délai où le titre aurait des couleurs intermédiaires. Avec le loader, c'est lui
        // qui l'active, au moment où le titre apparaît.
        if (!loading) zone.classList.add('neg-on');
        raf = requestAnimationFrame(loop);
        // pause hors écran ou onglet masqué ; au retour, le temps reprend où il en était (pas de saut)
        let pausedAt = 0;
        const setVisible = (v: boolean) => {
          if (v === visible) return;
          visible = v;
          if (v) {
            origin += performance.now() - pausedAt;
            if (!raf) raf = requestAnimationFrame(loop);
          } else pausedAt = performance.now();
        };
        let onScreen = true;
        let covered = false;
        const sync = () => setVisible(onScreen && !covered && !document.hidden);
        new IntersectionObserver(([e]) => {
          onScreen = e.isIntersecting;
          sync();
        }).observe(zone);
        document.addEventListener('visibilitychange', sync);
        // la Hero reste épinglée derrière les sections : une fois recouverte, inutile de dessiner
        window.addEventListener('lava:cover', (e) => {
          covered = (e as CustomEvent<boolean>).detail;
          sync();
        });
      }

      canvas.addEventListener('webglcontextlost', (e) => {
        e.preventDefault();
        canvas.classList.remove('is-ready');
        visible = false;
      });
    }
  }
</script>
