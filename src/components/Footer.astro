---
import './Footer.css';
import Logo from './Logo.astro';
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <Logo />
      <p class="footer-tagline">Design UX/UI, identité de marque &amp; sites sur-mesure.</p>
    </div>

    <div class="footer-contact">
      <span class="eyebrow">Contact</span>
      <a class="footer-mail" href="mailto:antoine.bruneau@protonmail.com">antoine.bruneau@protonmail.com</a>
      <span class="footer-location">France · à distance ou sur site</span>
    </div>

    <div class="footer-cta">
      <a
        class="btn btn-primary"
        href="mailto:antoine.bruneau@protonmail.com?subject=Votre%20projet"
      >
        Me contacter <span class="btn-arrow">→</span>
      </a>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <span>© <span data-year>2026</span> Antoine Bruneau</span>
    <span>Site en construction</span>
  </div>
</footer>
