---
import './Footer.css';
import Logo from './Logo.astro';
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <Logo />
      <p class="footer-tagline">Design UX/UI, identité de marque &amp; sites sur-mesure.</p>
    </div>

    <div class="footer-contact">
      <span class="label">Contact</span>
      <a class="footer-mail" href="tel:+33609111838">Tel. : 06 09 11 18 38</a>
      <a class="footer-mail" href="mailto:contact@antoinebruneau.fr">contact@antoinebruneau.fr</a>
      <span class="footer-location">France · à distance ou sur site</span>
    </div>

    <div class="footer-cta">
      <a class="btn btn-primary" href="/contact">
        Me contacter <span class="btn-arrow">→</span>
      </a>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <span><span data-year>2026</span> Antoine Bruneau · tous droits réservés</span>
  </div>
</footer>
