---
const footerLinks = [
  { href: '/#services', label: 'Services' },
  { href: '/projets', label: 'Projets' },
  { href: '/#process', label: 'Méthode' },
  { href: '/#tarifs', label: 'Tarifs' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/contact', label: 'Contact' },
];
---

<footer>
  <div class="wrap">
    <div class="footer-top">
      <p class="footer-line">Le design d'une agence.<br /><em>L'attention d'un artisan.</em></p>
      <nav class="footer-nav">
        {footerLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© <span data-year>2026</span> Antoine Bruneau — Designer UX/UI &amp; Graphiste indépendant</span>
      <span>antoine.bruneau@protonmail.com</span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 64px 0 40px;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    flex-wrap: wrap;
    margin-bottom: 52px;
  }

  .footer-line {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 32px);
    max-width: 16ch;
    line-height: 1.25;
  }

  .footer-line em {
    color: var(--accent-2);
    font-style: italic;
  }

  .footer-nav {
    display: flex;
    gap: 36px;
    flex-wrap: wrap;
  }

  .footer-nav a {
    font-size: 14px;
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--text);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 26px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    color: var(--text-faint);
    font-family: var(--font-mono);
  }

  @media (max-width: 600px) {
    .footer-top {
      flex-direction: column;
    }
  }
</style>
