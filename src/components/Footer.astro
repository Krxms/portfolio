    <div class="footer-brand">
      <Logo />
      <p class="footer-tagline">Webdesigner &amp; designer UX/UI</p>
    </div>

    <nav class="footer-legal" aria-label="Navigation du site">
      <span class="label">Navigation</span>
      <a href="/creation-site-web/">Création de site</a>
      <a href="/refonte-site-web/">Refonte de site</a>
      <a href="/audit-ux-ui/">Audit UX/UI</a>
      <a href="/projets/">Projets</a>
