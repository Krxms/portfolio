---
import './Footer.css';
import Logo from './Logo.astro';
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <Logo />
      <p class="footer-tagline">Concepteur numérique · Île-de-France</p>
    </div>

    <nav class="footer-legal" aria-label="Navigation du site">
      <span class="label">Navigation</span>
      <a href="/creation-site-web/">Création de site</a>
      <a href="/refonte-site-web/">Refonte de site</a>
      <a href="/interfaces-logiciels/">Interfaces et logiciels</a>
      <a href="/audit-ux-ui/">Audit UX/UI</a>
      <a href="/projets/le-cuistologue/">Réalisations</a>
      <a href="/a-propos/">À propos</a>
      <a href="/#faq">FAQ</a>
    </nav>

    <nav class="footer-legal" aria-label="Mentions légales">
      <span class="label">Conditions</span>
      <a href="/mentions-legales/">Mentions légales</a>
      <a href="/cgv/">CGV</a>
      <a href="/confidentialite/">Confidentialité</a>
      <a href="/cookies/">Cookies</a>
    </nav>

    <div class="footer-contact">
      <span class="label">Contact</span>
      <a class="footer-mail" href="tel:+33609111838">Téléphone : 06 09 11 18 38</a>
      <a class="footer-mail" href="mailto:contact@antoinebruneau.fr">contact@antoinebruneau.fr</a>
      <span class="footer-location">Île-de-France</span>
    </div>

    <div class="footer-cta">
      <a class="btn btn-primary" href="/contact/">
        Parlons de votre projet
      </a>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <span>{new Date().getFullYear()} Antoine Bruneau · tous droits réservés</span>
    <a class="footer-top" href="#main"><span class="footer-top-label">Haut de page</span><span class="footer-top-arrow" aria-hidden="true"></span></a>
  </div>
</footer>
