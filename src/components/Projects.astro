---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import './Projects.css';

const projets = (await getCollection('projets')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" id="projets">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">Projets</div>
      <h2>Le type de projet que j'aime construire.</h2>
      <p class="sub">Quatre projets conceptuels, pensés pour montrer comment je traite chaque catégorie de client — de l'artisan au produit digital.</p>
    </div>

    <div class="projects-grid reveal">
      {projets.map((projet) => (
        <ProjectCard
          slug={projet.id}
          title={projet.data.title}
          sector={projet.data.sector}
          summary={projet.data.summary}
          tags={projet.data.tags}
          variant={projet.data.variant}
        />
      ))}
    </div>

    <div class="projects-footer reveal">
      <p class="projects-note">
        Je démarre mon activité de freelance : ces études de cas sont des projets conceptuels qui illustrent ma façon
        de travailler. Mes prochains projets clients viendront enrichir cette page — et si vous faites partie des
        premiers, votre projet aura toute mon attention.
      </p>
      <a href="/projets" class="btn btn-ghost">Voir tous les projets <span class="btn-arrow">→</span></a>
    </div>
  </div>
</section>
