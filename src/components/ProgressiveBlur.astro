---
import './ProgressiveBlur.css';

interface Props {
  /** côté vers lequel le flou grandit : « bottom » (maximal en bas) ou « top » (maximal en haut) */
  toward?: 'bottom' | 'top';
}
const { toward = 'bottom' } = Astro.props;
// quatre couches de flou croissant, chacune visible sur sa propre bande : l'ensemble donne un flou progressif, sans palier visible.
// Chaque couche est un flou d'arrière-plan que le navigateur recalcule dès que ce qui passe derrière bouge : quatre au lieu de six, c'est
// un tiers de travail en moins au défilement, pour un rendu qu'on ne distingue pas.
const layers = [1, 3, 7, 14];
---

<div class={`pblur pblur--${toward}`} aria-hidden="true">
  {layers.map((b, i) => <i style={`--b:${b}px;--i:${i}`} />)}
</div>
