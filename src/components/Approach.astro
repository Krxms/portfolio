---
import './Approach.css';

const pillars = [
  {
    title: 'Un interlocuteur unique',
    text: "Pas de chef de projet entre vous et la personne qui dessine. Vous me parlez, je fais, vous voyez — à chaque étape.",
  },
  {
    title: 'Du design qui se code',
    text: "Je ne livre pas que des maquettes figées : je peux construire l'interface moi-même, en no-code avancé ou en développement sur-mesure.",
  },
  {
    title: "Un accompagnement qui s'adapte",
    text: "D'une identité visuelle ponctuelle à un suivi mensuel continu, le format suit votre budget et votre rythme — pas l'inverse.",
  },
];
---

<section class="approach" id="approche">
  <div class="wrap">
    <div class="reveal">
      <div class="eyebrow">Mon approche</div>
      <div class="approach-grid">
        <p class="approach-lede">
          La qualité ne devrait pas être réservée <strong>aux gros budgets</strong>.
        </p>
        <div class="pillars">
          {pillars.map((pillar, i) => (
            <div class="pillar">
              <span class="pillar-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{pillar.title}</h3>
                <p>{pillar.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
