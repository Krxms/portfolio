---
const pillars = [
  {
    title: 'Un interlocuteur unique',
    text: "Pas de chef de projet entre vous et la personne qui dessine. Vous me parlez, je fais, vous voyez — à chaque étape.",
  },
  {
    title: 'Du design qui se code',
    text: "Je ne livre pas que des maquettes figées : je peux construire l'interface moi-même, en no-code avancé ou en développement sur-mesure.",
  },
  {
    title: "Un accompagnement qui s'adapte",
    text: "D'une identité visuelle ponctuelle à un suivi mensuel continu, le format suit votre budget et votre rythme — pas l'inverse.",
  },
];
---

<section class="approach" id="approche">
  <div class="wrap">
    <div class="reveal">
      <div class="eyebrow">Mon approche</div>
      <div class="approach-grid">
        <p class="approach-lede">
          La qualité ne devrait pas être réservée aux gros budgets. Beaucoup de studios traitent leurs clients les
          plus modestes comme des <strong>dossiers secondaires</strong>. Je fais l'inverse.
        </p>
        <div class="pillars">
          {pillars.map((pillar, i) => (
            <div class="pillar">
              <span class="pillar-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{pillar.title}</h3>
                <p>{pillar.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .approach {
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 120px 0;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: start;
  }

  .approach-lede {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 29px);
    line-height: 1.5;
    color: var(--text);
    font-weight: 400;
  }

  .approach-lede strong {
    font-weight: 600;
    color: var(--accent-2);
  }

  .pillars {
    display: flex;
    flex-direction: column;
  }

  .pillar {
    display: flex;
    gap: 20px;
    padding: 26px 0;
    border-top: 1px solid var(--border);
  }

  .pillar:last-child {
    border-bottom: 1px solid var(--border);
  }

  .pillar-num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    padding-top: 3px;
    flex: none;
    width: 28px;
  }

  .pillar h3 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 16.5px;
    margin-bottom: 8px;
  }

  .pillar p {
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  @media (max-width: 980px) {
    .approach-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
</style>
