---
import './LinkUnder.css';

/* Lien secondaire souligné. Au survol : la graisse et la couleur montent d'un cran, et le trait du bas
   se remplit de la couleur du texte, de la gauche vers la droite, comme une barre de chargement.
   La graisse change sans décaler la mise en page : une copie invisible en gras réserve la largeur. */
interface Props {
  href: string;
  label: string;
  external?: boolean;
  /** « light » : texte clair, pour les fonds sombres */
  tone?: 'dark' | 'light';
  /** reflet qui suit le pointeur (pour la version pastille) */
  glow?: boolean;
}
const { href, label, external = false, tone = 'dark', glow = false } = Astro.props;
---

<a class:list={['link-under', tone === 'light' && 'link-under--light']} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} data-glow={glow ? '' : undefined}><span class="link-under-text" data-text={label}>{label}</span></a>
