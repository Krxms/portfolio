---
import './Tile.css';
import R from './R.astro';

interface Props {
  tone?: 'light' | 'dark';
  mesh?: 'a' | 'b';
  id?: string;
  label?: string;
  title: string;
  sub?: string;
  /** contenu étiré (1360 px), comme la vitrine du projet sur l'accueil */
  wide?: boolean;
  /** classes en plus sur la section */
  class?: string;
}
const { tone = 'light', mesh = 'a', id, label, title, sub, wide = false, class: extra } = Astro.props;
---

<section class:list={['tile', `tile--${tone}`, tone === 'dark' && `tile--mesh-${mesh}`, extra]} id={id} aria-labelledby={id ? `${id}-title` : undefined}>
  <div class:list={['wrap', 'tile-inner', wide && 'wrap--wide']}>
    <header class="tile-head">
      {label && <p class="tile-label"><R t={label} /></p>}
      <h2 id={id ? `${id}-title` : undefined}><R t={title} /></h2>
      {sub && <p class="tile-sub"><R t={sub} /></p>}
      <div class="tile-actions"><slot name="actions" /></div>
    </header>
    <slot />
  </div>
</section>
