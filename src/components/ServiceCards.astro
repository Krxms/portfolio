---
import './ServiceCards.css';

const cards = [
  {
    tone: 'warm',
    mark: 'sparkle',
    href: '/creation-site-web/',
    kicker: 'Création de site',
    title: 'Un site neuf, bâti sur vos besoins.',
    text: 'Structure, maquettes, intégration, SEO et optimisation IA, jusqu’à la mise en ligne. Un seul interlocuteur, trois à cinq semaines.',
  },
  {
    tone: 'blue',
    mark: 'loop',
    href: '/refonte-site-web/',
    kicker: 'Refonte de site',
    title: 'Votre site ne vous ressemble plus.',
    text: 'Vieilli, décalé de votre activité ? Je commence par un audit, puis je ne refais que ce qui le mérite, sans perdre votre référencement.',
  },
  {
    tone: 'mint',
    mark: 'lens',
    href: '/audit-ux-ui/',
    kicker: 'Audit UX/UI',
    title: 'Voir clair avant de décider.',
    text: 'Je parcours votre site, je repère ce qui freine vos visiteurs et je classe les corrections par priorité, restitution en visio comprise.',
    note: ' Son montant est déduit du projet si nous poursuivons ensemble.',
  },
] as const;
---

<ul class="cards" role="list">
  {
    cards.map((c) => (
      <li class={`card card--${c.tone}`} data-tilt>
        <div class="card-art" aria-hidden="true"><i class="s s1"></i><i class="s s2"></i><i class="s s3"></i></div>
        <p class="card-kicker">{c.kicker}</p>
        <h3 class="card-title"><a class="card-hit" href={c.href}>{c.title}</a></h3>
        <p class="card-text">
          {c.text}
          {c.note && <span class="card-note">{c.note}</span>}
        </p>
      </li>
    ))
  }
</ul>

<script>
  // Parallaxe très légère : seule la carte s'incline de deux degrés au plus vers le pointeur, son texte
  // reste collé à elle. Désactivée au tactile et avec « réduire les animations ».
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine && !calm) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      let frame = 0;
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          card.classList.add('is-tilting');
          card.style.setProperty('--rx', `${(-y * 2).toFixed(2)}deg`);
          card.style.setProperty('--ry', `${(x * 2).toFixed(2)}deg`);
        });
      });
      card.addEventListener('pointerleave', () => {
        cancelAnimationFrame(frame);
        card.classList.remove('is-tilting');
        ['--rx', '--ry'].forEach((p) => card.style.removeProperty(p));
      });
    });
  }
</script>
