---
import './Header.css';
import Logo from './Logo.astro';

const links = [
  { href: '/creation-site-web/', label: 'Création de site', cls: '' },
  { href: '/audit-ux-ui/', label: 'Audit UX/UI', cls: '' },
  { href: '/contact/', label: 'Contact', cls: 'header-nav-contact' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="backdrop"></div>
  <div class="wrap header-inner">
    <Logo />
    <nav class="header-nav" aria-label="Navigation principale">
      {
        links.map((l) => (
          <a href={l.href} class={l.cls} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
