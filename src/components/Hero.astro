---
import './Hero.css';
import HeroSphere from './HeroSphere.astro';
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-inner">
    <HeroSphere />
    <div class="hero-top-row">
      <span class="status-pill"><span class="pulse"></span>Disponible pour de nouvelles missions</span>
      <span class="hero-meta-right">Freelance · France</span>
    </div>

    <h1>Le design d'une agence. <em>L'attention d'un artisan.</em></h1>

    <div class="hero-bottom">
      <p class="hero-sub">
        Designer UX/UI &amp; graphiste indépendant, j'accompagne les artisans, commerçants et PME qui veulent une
        identité et des interfaces à la hauteur de leur exigence — sans la lourdeur ni le tarif d'une agence.
        Direction artistique, interfaces sur-mesure, et le développement qui va avec, quand le projet le demande.
      </p>
      <div class="hero-cta-row">
        <a href="/contact" class="btn btn-primary">Discutons de votre projet <span class="btn-arrow">→</span></a>
        <a href="/#services" class="btn btn-ghost">Voir mes services</a>
      </div>
    </div>

    <div class="hero-bottom-row">
      <span>Basé en France · missions à distance ou sur site</span>
      <a href="/#approche" class="scroll-cue">
        Découvrir mon approche
        <svg width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6"></path></svg>
      </a>
    </div>
  </div>
</section>
