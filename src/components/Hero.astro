---
import './Hero.css';
import FrostedCTA from './FrostedCTA.astro';
import LinkUnder from './LinkUnder.astro';
---

<section class="hero wrap" data-sticky-watch>
  <h1>
    <span class="hero-role"><span class="hero-role-a">Concepteur numérique</span></span>{' '}
    <span class="hero-l1">Vos besoins</span>{' '}
    <span class="hero-l2">prennent <em class="hero-word">forme</em>.</span>
  </h1>
  <p class="hero-sub">
    Je conçois des sites web et des interfaces de logiciels adaptés à vos besoins et à ceux qui les utilisent.
  </p>
  <div class="hero-actions">
    {/* bouton principal : le contact. Lien secondaire : l'étude de cas existante (Le Cuistologue), faute d'une page liste de réalisations */}
    <FrostedCTA href="/contact/" ink>Parlons de votre projet</FrostedCTA>
    <LinkUnder href="/projets/le-cuistologue/" label="Voir l’étude de cas" glow />
    <p class="hero-assure">Premier échange gratuit et sans engagement</p>
  </div>
</section>
