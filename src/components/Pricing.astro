---
const checkPath = 'M1 5.5 5 9.5 13 1.5';

const plans = [
  {
    audience: 'TPE & artisans',
    name: 'Essentiel',
    amount: '890 €',
    amountNote: 'à partir de',
    desc: "Une identité visuelle simple et un site vitrine en no-code, pour exister en ligne rapidement et sérieusement.",
    items: [
      'Logo & charte graphique express',
      "Site vitrine responsive (jusqu'à 5 sections)",
      'Mise en ligne incluse',
      'Livré en 2 à 3 semaines',
    ],
    featured: false,
  },
  {
    audience: 'PME & produits digitaux',
    name: 'Sur-mesure',
    amount: '2 400 €',
    amountNote: 'à partir de',
    desc: "UX/UI complet, design system et développement no-code avancé ou sur-mesure, pour un site ou un produit multi-pages.",
    items: [
      'Recherche & architecture UX',
      'Maquettes UI haute-fidélité + design system',
      'Développement no-code avancé ou sur-mesure',
      'Prototype testable avant développement',
    ],
    featured: true,
  },
  {
    audience: 'Suivi continu',
    name: 'Accompagnement',
    amount: '950 €',
    amountNote: '/ mois, à partir de',
    desc: "Un volant d'heures dédié chaque mois pour faire évoluer votre produit ou votre présence en ligne, sans repartir de zéro à chaque fois.",
    items: [
      "Volant d'heures mensuel dédié",
      'Un chantier actif à la fois',
      "Points d'avancement réguliers",
      'Formule flexible, ajustable chaque mois',
    ],
    featured: false,
  },
];
---

<section class="section" id="tarifs">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">Tarifs</div>
      <h2>Trois façons de démarrer, selon votre besoin.</h2>
      <p class="sub">Tarifs indicatifs — chaque devis est ajusté au périmètre réel de votre projet lors de notre premier échange.</p>
    </div>

    <div class="pricing-grid reveal">
      {plans.map((plan) => (
        <div class={`price-card ${plan.featured ? 'featured' : ''}`}>
          {plan.featured && <span class="price-badge">Le plus demandé</span>}
          <span class="price-audience">{plan.audience}</span>
          <h3>{plan.name}</h3>
          <div class="price-amount">{plan.amount} <span>{plan.amountNote}</span></div>
          <p class="price-desc">{plan.desc}</p>
          <ul class="price-list">
            {plan.items.map((item) => (
              <li>
                <svg width="14" height="11" viewBox="0 0 14 11" fill="none"><path d={checkPath} stroke="currentColor" stroke-width="1.8"></path></svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="/contact" class={`btn ${plan.featured ? 'btn-primary' : 'btn-ghost'}`}>Démarrer un projet</a>
        </div>
      ))}
    </div>
    <p class="pricing-footnote reveal">Pas sûr de la formule qui vous convient ? <a href="/contact" class="footnote-link">Discutons-en, sans engagement.</a></p>
  </div>
</section>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .price-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 38px 32px;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    position: relative;
  }

  .price-card.featured {
    border-color: transparent;
    background: linear-gradient(180deg, var(--surface), var(--surface)) padding-box,
      linear-gradient(155deg, var(--accent), var(--accent-deep)) border-box;
    border: 1px solid transparent;
    transform: translateY(-10px);
    box-shadow: 0 24px 50px -20px rgba(255, 90, 31, 0.35);
  }

  .price-badge {
    position: absolute;
    top: -14px;
    right: 28px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #fff5ea;
    padding: 6px 12px;
    border-radius: 100px;
  }

  .price-audience {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin-bottom: 16px;
  }

  .price-card h3 {
    font-size: 22px;
    margin-bottom: 10px;
  }

  .price-amount {
    font-family: var(--font-display);
    font-size: 38px;
    margin-bottom: 6px;
  }

  .price-amount span {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .price-desc {
    color: var(--text-muted);
    font-size: 14.5px;
    line-height: 1.65;
    margin: 14px 0 24px;
  }

  .price-list {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .price-list li {
    display: flex;
    gap: 10px;
    font-size: 14.5px;
    color: var(--text);
    align-items: flex-start;
  }

  .price-list li svg {
    flex: none;
    margin-top: 3px;
    color: var(--accent-2);
  }

  .pricing-footnote {
    text-align: center;
    color: var(--text-faint);
    font-size: 13.5px;
    margin-top: 32px;
  }

  .footnote-link {
    color: var(--accent-2);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 980px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
    .price-card.featured {
      transform: none;
    }
  }
</style>
