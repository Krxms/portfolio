---
import './Pricing.css';

const checkPath = 'M1 5.5 5 9.5 13 1.5';

const plans = [
  {
    audience: 'TPE & artisans',
    name: 'Essentiel',
    amount: '890 €',
    amountNote: 'à partir de',
    desc: "Une identité visuelle simple et un site vitrine en no-code, pour exister en ligne rapidement et sérieusement.",
    items: [
      'Logo & charte graphique express',
      "Site vitrine responsive (jusqu'à 5 sections)",
      'Mise en ligne incluse',
      'Livré en 2 à 3 semaines',
    ],
    featured: false,
  },
  {
    audience: 'PME & produits digitaux',
    name: 'Sur-mesure',
    amount: '2 400 €',
    amountNote: 'à partir de',
    desc: "UX/UI complet, design system et développement no-code avancé ou sur-mesure, pour un site ou un produit multi-pages.",
    items: [
      'Recherche & architecture UX',
      'Maquettes UI haute-fidélité + design system',
      'Développement no-code avancé ou sur-mesure',
      'Prototype testable avant développement',
    ],
    featured: true,
  },
  {
    audience: 'Suivi continu',
    name: 'Accompagnement',
    amount: '950 €',
    amountNote: '/ mois, à partir de',
    desc: "Un volant d'heures dédié chaque mois pour faire évoluer votre produit ou votre présence en ligne, sans repartir de zéro à chaque fois.",
    items: [
      "Volant d'heures mensuel dédié",
      'Un chantier actif à la fois',
      "Points d'avancement réguliers",
      'Formule flexible, ajustable chaque mois',
    ],
    featured: false,
  },
];
---

<section class="section" id="tarifs">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">Tarifs</div>
      <h2>Trois façons de démarrer, selon votre besoin.</h2>
      <p class="sub">Tarifs indicatifs — chaque devis est ajusté au périmètre réel de votre projet lors de notre premier échange.</p>
    </div>

    <div class="pricing-grid reveal">
      {plans.map((plan) => (
        <div class={`price-card ${plan.featured ? 'featured' : ''}`}>
          {plan.featured && <span class="price-badge">Le plus demandé</span>}
          <span class="price-audience">{plan.audience}</span>
          <h3>{plan.name}</h3>
          <div class="price-amount">{plan.amount} <span>{plan.amountNote}</span></div>
          <p class="price-desc">{plan.desc}</p>
          <ul class="price-list">
            {plan.items.map((item) => (
              <li>
                <svg width="14" height="11" viewBox="0 0 14 11" fill="none"><path d={checkPath} stroke="currentColor" stroke-width="1.8"></path></svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="/contact" class={`btn ${plan.featured ? 'btn-primary' : 'btn-ghost'}`}>Démarrer un projet</a>
        </div>
      ))}
    </div>
    <p class="pricing-footnote reveal">Pas sûr de la formule qui vous convient ? <a href="/contact" class="footnote-link">Discutons-en, sans engagement.</a></p>
  </div>
</section>
