---
import './HeroStage.css';
import Mark from './Mark.astro';
---

<div class="stage" aria-hidden="true">
  <div class="win glass">
    <div class="win-bar"><i></i><i></i><i></i></div>
    <div class="win-body">
      <div class="win-nav">
        <b class="win-logo"></b>
        <span><i></i><i></i><i></i></span>
      </div>
      <div class="win-hero">
        <div class="win-h1"></div>
        <div class="win-h1 win-h1--short"></div>
        <div class="win-p"></div>
        <div class="win-p win-p--short"></div>
        <div class="win-btns">
          <b class="win-btn win-btn--main"></b>
          <b class="win-btn"></b>
          <Mark kind="circle" class="stage-circle" />
          <Mark kind="arrow" class="stage-arrow" />
        </div>
      </div>
      <div class="win-grid"><i></i><i></i><i></i></div>
    </div>
  </div>

  <div class="chip chip--type glass">
    <span class="chip-aa">Aa</span>
    <span class="chip-cap">Bricolage Grotesque<br />Be Vietnam Pro</span>
  </div>

  <div class="chip chip--palette glass">
    <i style="background:#12202b"></i>
    <i style="background:#14509a"></i>
    <i style="background:#9fdcc8"></i>
    <i style="background:#ffcaa8"></i>
  </div>
</div>
