---
import './Devices.css';
import siteHero from '../assets/projets/cuistologue/site-hero.webp';
import mobileTop from '../assets/projets/cuistologue/mobile-top.webp';

/* Un site réellement livré (lecuistologue.fr) sur ordinateur et sur mobile : la preuve passe avant l'explication. */
---

<div class="dev">
  <div class="dev-laptop">
    <img
      src={siteHero.src}
      width={siteHero.width}
      height={siteHero.height}
      alt="Page d’accueil du site lecuistologue.fr, conçu et mis en ligne par Antoine Bruneau, sur ordinateur"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="dev-phone">
    <img src={mobileTop.src} width={mobileTop.width} height={mobileTop.height} alt="Le même site sur mobile" decoding="async" />
  </div>
</div>
