---
/* Écran d'arrivée : une goutte bleue qui respire sur le papier de la marque, puis le tout s'efface et révèle la Hero.
   Le contenu de la page est déjà dans le HTML ; rien n'est retiré, seulement rendu transparent un instant.
   Joué une fois par session, jamais avec « réduire les animations » (la classe has-loader n'est alors pas posée). */
---

<div class="loader" aria-hidden="true"><span class="loader-drop"></span></div>

<style is:global>
  html.has-loader {
    overflow: hidden;
  }

  .loader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    place-items: center;
    background: linear-gradient(100deg, #e6ecf7 0%, #e6f6f2 100%);
    pointer-events: none;
  }
  html.has-loader .loader,
  html.ld-in .loader {
    display: grid;
  }
  html.ld-in .loader {
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .loader-drop {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #386beb 0%, #1f45d6 52%, #172b85 100%);
    box-shadow: 0 18px 54px rgba(31, 69, 214, 0.32);
    animation: loader-drop 1.6s ease-in-out infinite;
  }
  html.ld-in .loader-drop {
    transform: scale(1.5);
    opacity: 0;
    transition:
      transform 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.6s ease;
    animation: none;
  }
  @keyframes loader-drop {
    0%,
    100% {
      transform: scale(0.9);
      border-radius: 50% 50% 50% 50% / 50% 50% 50% 50%;
    }
    33% {
      transform: scale(1.06);
      border-radius: 54% 46% 52% 48% / 46% 54% 46% 54%;
    }
    66% {
      transform: scale(0.97);
      border-radius: 47% 53% 46% 54% / 53% 47% 53% 47%;
    }
  }

  /* pendant le loader : le reste de la page est discret */
  html.has-loader .site-header,
  html.has-loader .sticky-cta,
  html.has-loader .hero > *,
  html.has-loader .hero-zone > .wrap {
    opacity: 0;
  }
  html.has-loader .hero > * {
    translate: 0 18px;
  }
  html.has-loader .curtain > .manifesto,
  html.has-loader main > :not(.curtain),
  html.has-loader .site-footer {
    visibility: hidden;
  }

  /* l'apparition : en cascade, titre puis texte puis boutons, pendant que le loader s'efface */
  html.ld-in .hero > * {
    transition:
      opacity 1s cubic-bezier(0.2, 0.7, 0.2, 1),
      translate 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  html.ld-in .hero > :nth-child(1) { transition-delay: 0.2s; }
  html.ld-in .hero > :nth-child(2) { transition-delay: 0.4s; }
  html.ld-in .hero > :nth-child(3) { transition-delay: 0.6s; }
  html.ld-in .hero-zone > .wrap {
    transition: opacity 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.7s;
  }
  html.ld-in .site-header {
    transition: opacity 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.5s;
  }
  html.ld-in .sticky-cta {
    transition: opacity 1s cubic-bezier(0.2, 0.7, 0.2, 1) 1s;
  }
</style>

<script>
  const root = document.documentElement;

  if (root.classList.contains('has-loader')) {
    try {
      sessionStorage.setItem('ld', '1');
    } catch (e) {}
    window.setTimeout(() => {
      root.classList.add('ld-in');
      root.classList.remove('has-loader');
      // le négatif du titre s'active en même temps qu'il apparaît : aucun délai avant le changement de couleur
      document.querySelector('.hero-zone')?.classList.add('neg-on');
      window.setTimeout(() => {
        root.classList.remove('ld-in');
        root.classList.add('loader-done');
      }, 1900);
    }, 1100);
  }
</script>
