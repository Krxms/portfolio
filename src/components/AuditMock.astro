---
import './AuditMock.css';
---

<figure class="audit-mock glass glass--dark" role="img" aria-label="Schéma illustratif d'une page avant et après audit, avec trois points annotés : la hiérarchie du titre, l'action principale et la lisibilité. Ce n'est pas une capture d'un client.">
  <div class="audit-mock-pair">
    <div class="audit-state">
      <span class="audit-tag">Constat</span>
      <div class="wf">
        <div class="wf-nav"><i></i><i></i><i></i></div>
        <div class="wf-title wf-title--small"></div>
        <div class="wf-lines"><i></i><i></i><i></i></div>
        <div class="wf-btn wf-btn--flat"></div>
      </div>
    </div>
    <div class="audit-state">
      <span class="audit-tag audit-tag--after">Recommandation</span>
      <div class="wf wf--after">
        <div class="wf-nav"><i></i><i></i><i></i></div>
        <div class="wf-title"><b class="pin">1</b></div>
        <div class="wf-lines wf-lines--short"><i></i><i></i><b class="pin">3</b></div>
        <div class="wf-btn"><b class="pin">2</b></div>
      </div>
    </div>
  </div>
  <figcaption>
    <span class="mono">1 Hiérarchie</span>
    <span class="mono">2 Action principale</span>
    <span class="mono">3 Lisibilité</span>
    <span class="audit-note">Schéma illustratif, pas une capture d'un client.</span>
  </figcaption>
</figure>
