---
import './Tile.css';
import './FinalCta.css';
import FrostedCTA from './FrostedCTA.astro';

interface Props {
  title: string;
  text: string;
  label: string;
  href?: string;
}
const { title, text, label, href = '/contact/' } = Astro.props;
---

<section class="cta-final tile tile--dark" data-sticky-watch>
  <div class="tile-light" aria-hidden="true"></div>
  <div class="wrap tile-inner">
    <div class="cta-panel glass glass--dark">
      <h2>{title}</h2>
      <p class="tile-sub">{text}</p>
      <div class="cta-final-row">
        <FrostedCTA href={href}>{label}</FrostedCTA>
        <p class="cta-final-direct">
          <a href="tel:+33609111838">06 09 11 18 38</a>
          <a href="mailto:contact@antoinebruneau.fr">contact@antoinebruneau.fr</a>
        </p>
      </div>
    </div>
  </div>
</section>
