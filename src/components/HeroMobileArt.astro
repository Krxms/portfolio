---
/* Illustration de la Hero sur téléphone (maquette validée) : en bas à droite, une grande arche bleue coupée par le bord de l'écran, une arche
   sable derrière, une fenêtre d'interface crème posée sur un socle bleu clair, et un disque orange devant. Un seul SVG, statique, sans image
   à télécharger. Le grain clair de l'arche bleue est un motif de points semés au hasard (tuile de 61 × 53, dimensions premières entre elles pour que la répétition ne se voie pas), sans filtre : rien à recalculer au défilement.
   Affichée à toutes les largeurs (sur ordinateur, la composition de HeroAmbient.astro est masquée). */
---

<div class="hm-art" aria-hidden="true">
  <svg viewBox="0 0 260 220" preserveAspectRatio="xMaxYMax meet" focusable="false">
    <defs>
      <linearGradient id="hm-blue" x1="0" y1="0" x2="0.4" y2="1">
        <stop offset="0" stop-color="#2a55d6" />
        <stop offset="1" stop-color="#1a3cbf" />
      </linearGradient>
      <linearGradient id="hm-sand" x1="1" y1="0" x2="0" y2="0.6">
        <stop offset="0" stop-color="#d9c29c" />
        <stop offset="1" stop-color="#ead9bd" stop-opacity="0.55" />
      </linearGradient>
      <radialGradient id="hm-orange" cx="0.38" cy="0.34" r="0.7">
        <stop offset="0" stop-color="#ff8a3d" />
        <stop offset="1" stop-color="#f0611a" />
      </radialGradient>
      <pattern id="hm-speck" width="61" height="53" patternUnits="userSpaceOnUse">
        <circle cx="19.8" cy="8.0" r="0.35" fill="#fff" opacity="0.25" />
        <circle cx="50.1" cy="5.0" r="0.9" fill="#fff" opacity="0.25" />
        <circle cx="55.5" cy="11.4" r="0.35" fill="#fff" opacity="0.6" />
        <circle cx="25.5" cy="12.8" r="0.9" fill="#fff" opacity="0.6" />
        <circle cx="3.6" cy="30.0" r="0.45" fill="#fff" opacity="0.25" />
        <circle cx="35.2" cy="21.0" r="0.45" fill="#fff" opacity="0.25" />
        <circle cx="34.0" cy="7.1" r="0.7" fill="#fff" opacity="0.35" />
        <circle cx="33.0" cy="30.3" r="0.9" fill="#fff" opacity="0.35" />
        <circle cx="6.3" cy="30.3" r="0.45" fill="#fff" opacity="0.45" />
        <circle cx="5.9" cy="37.7" r="0.9" fill="#fff" opacity="0.25" />
        <circle cx="37.8" cy="26.3" r="0.9" fill="#fff" opacity="0.6" />
        <circle cx="47.4" cy="24.7" r="0.7" fill="#fff" opacity="0.45" />
        <circle cx="18.3" cy="42.1" r="0.45" fill="#fff" opacity="0.25" />
        <circle cx="35.0" cy="27.8" r="0.55" fill="#fff" opacity="0.6" />
        <circle cx="17.6" cy="51.9" r="0.35" fill="#fff" opacity="0.6" />
        <circle cx="10.1" cy="18.1" r="0.7" fill="#fff" opacity="0.6" />
        <circle cx="2.4" cy="35.4" r="0.9" fill="#fff" opacity="0.45" />
        <circle cx="20.7" cy="18.6" r="0.7" fill="#fff" opacity="0.6" />
        <circle cx="4.2" cy="5.0" r="0.55" fill="#fff" opacity="0.6" />
        <circle cx="42.5" cy="3.4" r="0.55" fill="#fff" opacity="0.6" />
        <circle cx="17.4" cy="20.4" r="0.55" fill="#fff" opacity="0.25" />
        <circle cx="57.4" cy="18.8" r="0.9" fill="#fff" opacity="0.25" />
        <circle cx="30.1" cy="11.6" r="0.55" fill="#fff" opacity="0.35" />
        <circle cx="45.0" cy="21.1" r="0.7" fill="#fff" opacity="0.25" />
        <circle cx="10.1" cy="21.3" r="0.55" fill="#fff" opacity="0.35" />
        <circle cx="50.0" cy="45.8" r="0.55" fill="#fff" opacity="0.6" />
      </pattern>
      <filter id="hm-shadow" x="-20%" y="-20%" width="140%" height="150%">
        <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#0b1a4a" flood-opacity="0.18" />
      </filter>
    </defs>

    <path d="M9 220 V207 A70 70 0 0 1 149 207 V220 Z" fill="url(#hm-sand)" />
    <path d="M106 220 V172 A150 150 0 0 1 406 172 V220 Z" fill="url(#hm-blue)" />
    <path d="M106 220 V172 A150 150 0 0 1 406 172 V220 Z" fill="url(#hm-speck)" />
    <rect x="44" y="197" width="147" height="23" fill="#9fb5e6" />

    <g filter="url(#hm-shadow)">
      <rect x="86" y="103" width="146" height="91" rx="7" fill="#f8f3ea" />
    </g>
    <circle cx="101" cy="116" r="3.4" fill="#a9bde8" />
    <circle cx="112" cy="116" r="3.4" fill="#a9bde8" />
    <circle cx="123" cy="116" r="3.4" fill="#a9bde8" />
    <rect x="97" y="129" width="63" height="52" rx="2" fill="#a7bfe9" />
    <rect x="171" y="137" width="50" height="5" rx="2.5" fill="#a9bde8" />
    <rect x="171" y="148" width="31" height="5" rx="2.5" fill="#a9bde8" />

    <circle cx="199" cy="182" r="18" fill="url(#hm-orange)" />
  </svg>
</div>

<style>
  .hm-art {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 0;
    width: min(62vw, 300px);
    pointer-events: none;
  }

  .hm-art svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ordinateur : la même illustration, en plus grand, en bas à droite (le texte reste à gauche) */
  @media (min-width: 701px) {
    .hm-art {
      width: min(44vw, 700px);
    }
  }
</style>
