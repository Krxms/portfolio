    pointer-events: none;
  }

  .hm-art svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* le grain : la tuile fine du téléphone, puis celle de l'ordinateur (voir plus haut) ; plus discret sur les formes claires et orange */
  .hm-grain {
    fill: url(#hm-speck-m);
  }

  .hm-grain--soft {
    opacity: 0.45;
  }

  /* ordinateur : la même illustration, en plus grand, en bas à droite (le texte reste à gauche) */
