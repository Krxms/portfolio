---
import './FrostedCTA.css';

interface Props {
  href: string;
  /** survol « encre » : une tache de matière se répand depuis le point d'entrée du pointeur, et le libellé défile (voir cta.css et src/scripts/site.js) */
  ink?: boolean;
}

const { href, ink = false } = Astro.props;
// pour le défilement du libellé, le texte est écrit deux fois : l'original, et un double (masqué aux lecteurs d'écran) qui arrive par le bas
const label = ink ? await Astro.slots.render('default') : '';
---

<a href={href} class="frosted-cta" data-glow data-ink={ink ? '' : undefined}>
  {
    ink ? (
      <span class="text">
        <span class="roll">
          <span class="roll-a" set:html={label} />
          <span class="roll-b" aria-hidden="true" set:html={label} />
        </span>
      </span>
    ) : (
      <span class="text"><slot /></span>
    )
  }
</a>

