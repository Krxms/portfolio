---
import './Process.css';
import Mark from './Mark.astro';

interface Props {
  steps: { title: string; text: string; gets?: string; when?: string }[];
  /* true : la flèche se révèle avec le défilement (scenes.js), en même temps que les tuiles */
  scene?: boolean;
}
const { steps, scene = false } = Astro.props;

/* ---- Spectre des étapes : du violet au bleu klein, puis au lagon et à la menthe (l'évolution des teintes de la lave).
   Chaque étape prend sa couleur sur ce dégradé ; le chiffre, la goutte et le ruban la reprennent. ---- */
const anchors = ['#6b4de0', '#1f45d6', '#1f94bf', '#1e9d8e'];
const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
const mixHex = (a: string, b: string, t: number) => {
  const x = hex(a), y = hex(b);
  return '#' + x.map((v, i) => Math.round(v + (y[i] - v) * t).toString(16).padStart(2, '0')).join('');
};
const n = steps.length;
const stepColor = (i: number) => {
  const p = n > 1 ? (i / (n - 1)) * (anchors.length - 1) : 0;
  const k = Math.min(anchors.length - 2, Math.floor(p));
  return mixHex(anchors[k], anchors[k + 1], p - k);
};
const cols = steps.map((_, i) => stepColor(i));
---

<div class="proc-wrap" data-scene={scene ? "" : undefined}>
  <Mark kind="timeline" class="proc-timeline" />
<ol class={`proc proc--${steps.length}`} role="list">
  {
    steps.map((s, i) => (
      <li class="proc-step" style={`--num-c:${cols[i]}`}>
        <span class="proc-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        {s.when && <span class="proc-when">{s.when}</span>}
        <h3>{s.title}</h3>
        <p>{s.text}</p>
        {s.gets && (
          <div class="proc-gets">
            <p><span>Vous recevez</span> {s.gets}</p>
          </div>
        )}
      </li>
    ))
  }
</ol>
</div>

<script>
  // La flèche chronologique se trace de gauche à droite (la pointe arrive en dernier), une seule fois, quand elle
  // entre à l'écran. Sans JavaScript ou avec « réduire les animations », elle est affichée en entier.
  const arrow = document.querySelector<SVGElement>('.proc-wrap:not([data-scene]) .proc-timeline');
  if (arrow && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    arrow.classList.add('is-armed');
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          arrow.classList.add('is-drawing');
          io.disconnect();
        }
      },
      { threshold: 0.2, rootMargin: '0px 0px -10% 0px' },
    );
    // On observe le conteneur, pas la flèche : tant qu'elle est masquée par son clip-path, le navigateur calcule une
    // zone visible nulle et l'observateur ne se déclencherait jamais.
    io.observe(arrow.parentElement ?? arrow);
  }
</script>
