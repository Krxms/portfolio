    color: var(--accent-2);
    margin-top: 6px;
    min-height: 18px;
  }

  @media (max-width: 980px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  @media (max-width: 600px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
