---
import './ContactCta.css';
---

<section class="contact-cta">
  <div class="cta-glow" aria-hidden="true"></div>
  <div class="wrap cta-inner reveal">
    <div class="eyebrow">Contact</div>
    <h2>Un projet en tête ? Parlons-en.</h2>
    <p class="sub">Décrivez-moi votre besoin en quelques lignes — je reviens vers vous sous 24h ouvrées, sans engagement.</p>
    <a href="/contact" class="btn btn-primary">Discutons de votre projet <span class="btn-arrow">→</span></a>
  </div>
</section>
