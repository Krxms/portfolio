---
import '../styles/project-shared.css';
import './ProjectCard.css';

interface Props {
  slug: string;
  title: string;
  sector: string;
  summary: string;
  tags: string[];
  variant: number;
}

const { slug, title, sector, summary, tags, variant } = Astro.props;

const icons: Record<number, string> = {
  1: 'M8 40h32M12 40V20a4 4 0 0 1 4-4h16a4 4 0 0 1 4 4v20M18 40V28h12v12M20 12c0-3 1.8-5 4-5s4 2 4 5-4 6-4 6-4-3-4-6Z',
  2: 'M24 18v8m-10 14v-6a10 10 0 0 1 20 0v6M8 40h32M18 26l-4 4m16-4 4 4',
  3: '',
  4: 'M24 6C15 6 8 14 8 22c0 11 16 20 16 20s16-9 16-20c0-8-7-16-16-16Z',
};
---

<article class="project-card">
  <a href={`/projets/${slug}`} class={`project-cover cover-${variant}`} aria-hidden="true">
    {variant === 2 ? (
      <svg viewBox="0 0 48 48" fill="none" stroke="#ffb84d" stroke-width="1.4">
        <circle cx="24" cy="14" r="4"></circle>
        <path d={icons[2]}></path>
      </svg>
    ) : variant === 3 ? (
      <svg viewBox="0 0 48 48" fill="none" stroke="#ffb84d" stroke-width="1.4">
        <rect x="7" y="9" width="34" height="26" rx="2"></rect>
        <path d="M13 29v-8m8 8V17m8 12v-5m8 5v-11"></path>
      </svg>
    ) : variant === 4 ? (
      <svg viewBox="0 0 48 48" fill="none" stroke="#ffb84d" stroke-width="1.4">
        <path d={icons[4]}></path>
        <circle cx="24" cy="22" r="5"></circle>
      </svg>
    ) : (
      <svg viewBox="0 0 48 48" fill="none" stroke="#ffb84d" stroke-width="1.4">
        <path d={icons[1]}></path>
      </svg>
    )}
  </a>
  <div class="project-body">
    <div class="project-top-row">
      <span class="project-sector">{sector}</span>
      <span class="concept-badge">Projet concept</span>
    </div>
    <h3><a href={`/projets/${slug}`}>{title}</a></h3>
    <p>{summary}</p>
    <div class="tag-row">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </div>
</article>
