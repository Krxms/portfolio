---
import BaseLayout from '../layouts/BaseLayout.astro';
import './contact.css';
---

<BaseLayout
  title="Contact, devis designer UX/UI freelance"
  description="Parlez-moi de votre projet de site web, d'interface ou d'audit UX/UI. Designer freelance basé à Guitrancourt (78), réponse sous 24 h ouvrées."
>
  <section class="section contact-page wrap">
    <div class="page-head">
      <span class="label">Contact</span>
      <h1>Parlons de votre projet.</h1>
      <p class="sub">Décrivez-moi votre besoin en quelques lignes — je reviens vers vous sous 24h ouvrées.</p>
    </div>

    <div class="contact-grid">
      <form id="contactForm" novalidate>
        <p class="form-hint">Tous les champs sont obligatoires.</p>
        <input
          type="text"
          name="company"
          class="hp-field"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <div class="field-row">
          <div class="field">
            <label for="fName">Nom</label>
            <input type="text" id="fName" name="name" placeholder="Votre nom" autocomplete="name" required aria-required="true" />
          </div>
          <div class="field">
            <label for="fEmail">Email</label>
            <input type="email" id="fEmail" name="email" placeholder="vous@exemple.fr" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" required aria-required="true" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="fType">Type de projet</label>
            <select id="fType" name="type">
              <option>Création de site web</option>
              <option>Design UX/UI de produit</option>
              <option>Audit UX/UI</option>
              <option>Accompagnement mensuel</option>
              <option>Identité de marque</option>
              <option>Autre</option>
            </select>
          </div>
          <div class="field">
            <label for="fBudget">Budget</label>
            <select id="fBudget" name="budget">
              <option>À définir ensemble</option>
              <option>Déjà fixé (je le précise dans le message)</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="fMessage">Message</label>
          <p class="field-hint" id="fMessageHint">Quelques lignes suffisent : votre activité, ce que vous attendez, et une date si vous en avez une.</p>
          <textarea id="fMessage" aria-describedby="fMessageHint" name="message" placeholder="Parlez-moi de votre projet, de vos objectifs, de vos délais..." required aria-required="true"></textarea>
        </div>
        <p class="form-promise">Je réponds sous 24 h ouvrées. Le premier échange est gratuit et sans engagement.</p>
        <button type="submit" class="btn btn-primary">Envoyer <span class="btn-arrow">→</span></button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite" aria-atomic="true"></p>
      </form>

      <div class="contact-side">
        <div class="contact-direct">
          <span class="label">Écrire directement</span>
          <a href="mailto:contact@antoinebruneau.fr">contact@antoinebruneau.fr</a>
          <a href="tel:+33609111838">06 09 11 18 38</a>
        </div>
        <p class="contact-note">
          Que votre projet soit une identité complète, un site vitrine ou un produit digital plus complexe, le
          premier échange ne coûte rien et ne vous engage à rien.
        </p>
      </div>
    </div>
  </section>

  <script src="../scripts/contactForm.js"></script>
</BaseLayout>
