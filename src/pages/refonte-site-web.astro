---
import R from '../components/R.astro';
import SceneArt from '../components/SceneArt.astro';
import { plain } from '../lib/fmt';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tile from '../components/Tile.astro';
import PageHero from '../components/PageHero.astro';
import Manifesto from '../components/Manifesto.astro';
import ProjectTeaser from '../components/ProjectTeaser.astro';
import Faq from '../components/Faq.astro';
import LinkUnder from '../components/LinkUnder.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyCta from '../components/StickyCta.astro';
import '../styles/scenes.css';
// Même langage visuel et mêmes composants que la page « Création de site » : on réutilise sa feuille de style (préfixe cs-)
import './creation-site-web.css';

const site = 'https://antoinebruneau.fr';
const description =
  'Refonte de site web : lecture de l’existant, corrections ciblées, refonte partielle ou complète, plan de redirection pour limiter les risques SEO.';

const schema: { '@context': string; '@graph': Array<Record<string, unknown>> } = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${site}/refonte-site-web/#refonte`,
      name: 'Refonte de site web',
      serviceType: 'Refonte de site web',
      description:
        'Lecture de l’existant, corrections ciblées, refonte partielle ou complète, reprise des contenus et plan de redirection des anciennes adresses.',
      url: `${site}/refonte-site-web/`,
      inLanguage: 'fr-FR',
      areaServed: { '@type': 'Country', name: 'France' },
      provider: { '@type': 'ProfessionalService', '@id': `${site}/#service`, name: 'Antoine Bruneau' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Refonte de site', item: `${site}/refonte-site-web/` },
      ],
    },
  ],
};

// Les cinq signes, dans l'ordre des repères numérotés de la scène (voir .cs-pin) : chaque repère désigne un défaut de l'ancien site.
const signs = [
  { t: 'Vos visiteurs ne vous écrivent pas', d: 'Le trafic est là, mais personne ne prend contact : le parcours et les appels à l’action sont à repenser.' },
  { t: 'Il se lit mal sur mobile', d: 'Une grande partie de vos visiteurs arrive depuis un téléphone : si le site y est pénible, ils repartent.' },
  { t: 'On vous trouve difficilement', d: 'Structure confuse, titres approximatifs, pages lentes : les moteurs de recherche comprennent mal votre site.' },
  { t: 'Il ne ressemble plus à votre activité', d: 'Votre offre a évolué, votre site est resté à l’époque de sa création.' },
  { t: 'Vous n’osez plus y toucher', d: 'Modifier un texte devient une affaire de spécialiste, ou casse la mise en page.' },
];

// La démarche : les quatre étapes de l'accueil (mêmes titres, mêmes scènes), détaillées pour une refonte ; « Vous recevez » : le livrable de l'étape.
const steps = [
  { t: 'Comprendre', d: 'Un premier échange et une lecture rapide de votre site, gratuits.' },
  { t: 'Cadrer', d: 'Ce qu’on garde, ce qu’on change et le calendrier, dans un devis valable 30 jours.', gets: 'Le devis.' },
  { t: 'Concevoir', d: 'Le plan de la refonte, puis les maquettes, ajustées avec vous.', gets: 'Le plan et les maquettes validées.' },
  { t: 'Réaliser', d: 'Le site construit, vos contenus repris, les anciennes adresses redirigées, puis la bascule.', gets: 'Votre nouveau site en ligne et les accès convenus.' },
];
// De la correction ciblée à la refonte complète. `me` : la part refaite, en trois crans seulement (un tiers, deux tiers, tout), lue sur la
// jauge sans pourcentage. `name` : le type de projet ; `fit` complète « Pour vous si » ; `share` : ce qui change, lu par les lecteurs d'écran.
const scopes = [
  { name: 'Corrections ciblées', t: 'Les pages clés, remises à niveau', d: 'Quelques pages ou parcours (accueil, contact, offre) sont repris. Le reste de votre site reste en place.', fit: 'votre site tient globalement, mais quelques pages freinent vos visiteurs.', me: 33.333, share: 'Ce qui change : quelques pages ou parcours ; le reste du site ne bouge pas.' },
  { name: 'Refonte partielle', t: 'Un nouveau visage, vos contenus gardés', d: 'Le design et les pages principales sont refaits. Les contenus qui fonctionnent sont conservés et réorganisés.', fit: 'votre image et vos pages principales ne vous ressemblent plus, mais vos contenus sont bons.', me: 66.667, share: 'Ce qui change : le design et les pages principales ; la structure et les contenus qui fonctionnent sont conservés.' },
  { name: 'Refonte complète', t: 'Une base neuve, vos contenus repris', d: 'Nouvelle structure, nouveau design, contenus repris et plan de redirection des anciennes adresses.', fit: 'la structure elle-même pose problème : organisation, technique ou référencement.', me: 100, share: 'Ce qui change : la structure, le design et la réalisation ; les contenus utiles sont repris.' },
];
// Ce que je prépare : valable pour toute refonte, quelle que soit son ampleur.
const commitments = [
  { t: 'Un plan de redirection', d: 'J’identifie les anciennes adresses et prépare les redirections vers les pages les plus pertinentes du nouveau site, lorsque cela est justifié, afin de préserver autant que possible les accès et le référencement existants.' },
  { t: 'Une bascule préparée', d: 'Vos contenus utiles sont repris. Le site existant est sauvegardé, ou sa sauvegarde est vérifiée, avant la mise en ligne, selon les accès disponibles. La date de bascule est choisie avec vous.' },
  { t: 'Ce qui vous revient', d: 'Les créations finales originales réalisées pour votre projet vous sont cédées au paiement intégral. Les solutions tierces restent soumises à leurs licences, et les accès vous sont remis.' },
  { t: 'Des corrections après la mise en ligne', d: 'Je contrôle le site une fois publié. Pendant 30 jours après la réception, je corrige sans frais les anomalies qui relèvent de ma prestation.' },
];
// D'autres portes d'entrée : le nom, puis ce que l'offre apporte, en une phrase.
const nextOffers = [
  { t: 'Audit UX/UI', d: 'Un diagnostic détaillé avant de décider.', href: '/audit-ux-ui/' },
  { t: 'Création de site', d: 'Repartir d’une page blanche : un nouveau site, construit autour de votre activité.', href: '/creation-site-web/' },
];
const faq = [
  {
    q: 'Combien coûte une refonte ?',
    a: 'Cela dépend de la taille du site, de ce qu’on garde et de ce qu’on refait. Après un premier échange gratuit, je vous envoie un devis gratuit et détaillé : vous savez exactement ce qui est inclus avant de vous engager.',
  },
  {
    q: 'Vais-je perdre mon référencement ?',
    a: 'Je limite ce risque : les anciennes adresses sont redirigées, lorsque c’est justifié, vers les pages les plus pertinentes du nouveau site, les titres et descriptions utiles sont repris, et je vérifie le site après la mise en ligne. Aucune refonte ne garantit une position dans les résultats.',
  },
  {
    q: 'L’audit est-il obligatoire ?',
    a: 'Non. Pour établir le devis, une lecture rapide de votre site suffit. L’audit UX/UI apporte un diagnostic écrit et détaillé avant de décider. Si vous commandez la refonte dans les trois mois qui suivent sa restitution, 50 % de son montant hors taxes est déduit du devis.',
  },
  {
    q: 'Combien de temps dure une refonte ?',
    a: 'Cela dépend de la taille du site, de ce que la lecture de l’existant révèle et de la rapidité de vos retours. Le calendrier est fixé avec vous dans le devis.',
  },
];
// Les questions de la page, exactement celles qui sont affichées (aide les moteurs de réponse et les assistants IA à les citer)
schema['@graph'].push({
  '@type': 'FAQPage',
  '@id': `${site}/refonte-site-web/#faq`,
  inLanguage: 'fr-FR',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: plain(item.q), acceptedAnswer: { '@type': 'Answer', text: plain(item.a) } })),
});
---

<BaseLayout title="Refonte de site web, sans repartir de zéro" description={description} schema={schema}>
  {/* Alternance clair / sombre, comme la page Création : la Hero (clair), les signes (sombre, qui passe par-dessus la Hero : le rideau),
      l'ampleur (clair), la démarche (sombre), le Cuistologue (clair), puis le cadre, la FAQ et l'appel final (sombres). */}
  <div class="curtain">
  <PageHero
    modern
    crumb="Refonte de site"
    kicker="Refonte de site · Indépendants, PME"
    line1="Gardez ce qui marche,"
    line2="refaites le reste."
    lead={'Je pars de votre site actuel pour identifier ce qui mérite d’être conservé, corrigé ou repensé.'}
    ctaHref="/contact/?sujet=refonte"
    ctaLabel="Faire évoluer mon site"
    linkHref="/audit-ux-ui/"
    linkLabel="Commencer par un audit"
    note="Premier échange gratuit et sans engagement · Réponse sous deux jours ouvrés en général"
  />

  <section class="tile tile--dark tile--mesh-a cs-dark" id="signes" aria-labelledby="signes-title">
    <div class="wrap wrap--wide tile-inner">
      <header class="tile-head">
        <p class="tile-label">Quand s’en occuper</p>
        <h2 id="signes-title">Votre site ne fait plus le travail ?</h2>
        <p class="tile-sub">Certains problèmes se corrigent sans tout reconstruire.</p>
      </header>

      <!-- La scène montre l'ancien site, terne et daté ; chaque repère orange désigne un défaut, détaillé dans la liste dessous sous le même numéro. -->
      <div class="cs-stage cs-stage--old" aria-hidden="true">
        <SceneArt scene="refonte" />
        <span class="cs-shape cs-disc concrete"></span>
        <span class="cs-shape cs-arch concrete"></span>
        <span class="cs-shape cs-quarter concrete"></span>

        <div class="cs-site">
          <div class="cs-site-bar">
            <i></i><i></i><i></i>
            <span class="cs-addr">
              <svg viewBox="0 0 12 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M3 6V4.5a3 3 0 0 1 6 0V6M2 6h8v6H2z" /></svg>
              votre-site.fr
            </span>
            <span class="cs-live cs-live--old">© 2014</span>
          </div>
          <div class="cs-site-body">
            <div class="cs-site-nav"><b></b><span></span><span></span><span></span><span></span><em></em></div>
            <div class="cs-site-hero">
              <div class="cs-site-copy">
                <strong>Bienvenue sur notre site</strong>
                <p>Découvrez toutes nos prestations, nos actualités et nos références.</p>
                <span class="cs-site-cta">En savoir plus</span>
              </div>
              <div class="cs-site-img"></div>
            </div>
            <div class="cs-site-cards"><i></i><i></i><i></i></div>
          </div>
        </div>

        <div class="cs-phone"><i class="cs-site-img cs-phone-hero"></i><i class="cs-phone-line"></i><i class="cs-phone-line"></i><i class="cs-phone-line s"></i><i class="cs-phone-btn"></i></div>

        <div class="cs-serp">
          <span class="cs-serp-url"><i></i>votre-site.fr › accueil</span>
          <b>Accueil – Site officiel</b>
          <i class="cs-serp-line"></i>
          <i class="cs-serp-line s"></i>
        </div>

        <div class="cs-guide cs-guide--locked">
          <span><i></i>Modifier un texte</span>
          <span><i></i>Ajouter une page</span>
          <span><i></i>Publier</span>
        </div>

        {signs.map((_, i) => <span class={`cs-pin cs-pin--${i + 1}`}>{i + 1}</span>)}
      </div>

      <ol class="cs-deliv" role="list">
        {
          signs.map((r, i) => (
            <li>
              <span class="cs-deliv-n" aria-hidden="true">{i + 1}</span>
              <h3><R t={r.t} /></h3>
              <p><R t={r.d} /></p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  </div>

  <Tile id="ampleur" wide title="Vous choisissez l’ampleur." sub="On ne refait que ce qui le mérite. Le niveau d’intervention se décide après la lecture de votre site, pas avant.">
    {/* Ordinateur : un panneau bleu, trois lignes. Mobile : chaque ligne devient une carte bleue, dans un carrousel latéral (même composant que la page Création). */}
    <div class="cs-lv-panel panel-blue panel-blue--riso">
      <div class="cs-lv-axis" aria-hidden="true">
        <div class="cs-lv-axis-track"><span>Je touche peu</span><i></i><span>Je reconstruis tout</span></div>
      </div>
      <ol class="cs-lv-list" role="list">
        {
          scopes.map((l) => (
            <li class="cs-lv">
              <div class="cs-lv-main">
                <p class="cs-level-n"><R t={l.name} /></p>
                <h3><R t={l.t} /></h3>
                <p><R t={l.d} /></p>
              </div>
              <div class="cs-lv-gauge">
                <i class="cs-lv-sh" aria-hidden="true"></i>
                <i class="cs-lv-sh" aria-hidden="true"></i>
                <div class="cs-lv-win">
                  <div class="cs-share" role="img" aria-label={l.share} style={`--me: ${l.me}%`}>
                    <i></i>
                  </div>
                  <div class="cs-share-legend" aria-hidden="true"><span>Refait</span><span>Conservé</span></div>
                </div>
              </div>
              <p class="cs-fit"><span>Pour vous si</span> {l.fit}</p>
            </li>
          ))
        }
      </ol>
    </div>
    <p class="cs-more">Votre besoin concerne une application ou un logiciel ? <LinkUnder href="/interfaces-logiciels/" label="Voir Interfaces et logiciels" /></p>
  </Tile>

  <Manifesto id="methode" title="De l’analyse à la mise en ligne" sub="Quatre étapes, et un calendrier fixé avec vous dans le devis." steps={steps} />

  <ProjectTeaser label="Réalisation" caseStudy />

  <div class="dark-zone">
    <Tile tone="dark" wide id="cadre" title="Changer de site, sans avancer à l’aveugle." sub="Contenus, redirections et mise en ligne : chaque transition se prépare.">
      {/* tout ce qui suit le sous-titre apparaît d'un seul bloc, en fondu, quand ses mots arrivent vers la fin (scenes.js) */}
      <div class="cs-follow">
        <ul class="cs-commit" role="list">
          {commitments.map((c) => <li><h3><R t={c.t} /></h3><p><R t={c.d} /></p></li>)}
        </ul>
        {/* une simple phrase sous les engagements : ce qu'il faut réunir de son côté */}
        <div class="cs-start">
          <p>
            <strong>Pour avancer, j’ai besoin de trois choses de votre part.</strong> Les accès à votre site actuel, à son hébergement et à votre nom de
            domaine. Des textes et des images à jour (la rédaction n’est pas incluse). Vos retours et validations, dans les délais convenus.
          </p>
        </div>

        {/* d'autres portes d'entrée, chacune avec son bénéfice en une phrase : le nom de l'offre, puis ce qu'elle apporte */}
        <div class="cs-next">
          <p class="cs-next-label">Autres façons de commencer</p>
          <ul role="list">
            {
              nextOffers.map((o) => (
                <li>
                  <a href={o.href}>
                    <strong><R t={o.t} /></strong>
                    <span><R t={o.d} /></span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Tile>

    <Tile id="faq" tone="dark" title="Avant de vous lancer" sub="Les questions qui reviennent le plus, en quelques lignes. Une autre vous vient ? Un message suffit.">
      <Faq items={faq} />
      <p class="cs-more"><LinkUnder href="/#faq" label="Toutes les questions" tone="light" /></p>
    </Tile>

    <FinalCta
      title="Dites-moi ce qui ne va plus."
      text="Décrivez l’existant et ce que vous en attendez."
      label="Faire évoluer mon site"
      href="/contact/?sujet=refonte"
    />
  </div>
  <StickyCta href="/contact/?sujet=refonte" label="Faire évoluer mon site" />
</BaseLayout>

<script>
  import '../scripts/scenes.js';
</script>
