---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((projet) => ({
    params: { slug: projet.id },
    props: { projet },
  }));
}

const { projet } = Astro.props;
const { title, sector, tags, variant, brief, approach, outcome } = projet.data;
---

<BaseLayout title={title} description={`${title} — ${sector}. Projet conceptuel : ${tags.join(', ')}.`}>
  <article class="section case-study">
    <div class="wrap">
      <a href="/projets" class="back-link">← Tous les projets</a>

      <div class="case-head reveal">
        <div class="case-head-top">
          <span class="project-sector">{sector}</span>
          <span class="concept-badge">Projet concept</span>
        </div>
        <h1>{title}</h1>
        <div class="tag-row">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>

      <div class={`case-cover cover-${variant} reveal`} aria-hidden="true"></div>

      <div class="case-body reveal">
        <div class="case-block">
          <span class="case-label">Le brief</span>
          <p>{brief}</p>
        </div>
        <div class="case-block">
          <span class="case-label">L'approche</span>
          <p>{approach}</p>
        </div>
        <div class="case-block">
          <span class="case-label">Le résultat</span>
          <p>{outcome}</p>
        </div>
      </div>

      <div class="case-cta reveal">
        <h2>Un projet similaire en tête ?</h2>
        <a href="/contact" class="btn btn-primary">Discutons de votre projet <span class="btn-arrow">→</span></a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case-study {
    padding-top: 150px;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 40px;
  }

  .back-link:hover {
    color: var(--accent-2);
  }

  .case-head {
    max-width: 760px;
    margin-bottom: 48px;
  }

  .case-head-top {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .project-sector {
    font-size: 12.5px;
    color: var(--text-faint);
    font-family: var(--font-mono);
  }

  .concept-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--accent-2);
    border: 1px solid rgba(255, 184, 77, 0.35);
    background: rgba(255, 184, 77, 0.08);
    padding: 4px 10px;
    border-radius: 100px;
  }

  .case-head h1 {
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.05;
    margin-bottom: 20px;
  }

  .case-cover {
    height: 340px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    margin-bottom: 64px;
  }

  .cover-1 {
    background: radial-gradient(120% 140% at 20% 15%, #3a2115, #170d09 70%);
  }
  .cover-2 {
    background: radial-gradient(120% 140% at 80% 20%, #331226, #150910 70%);
  }
  .cover-3 {
    background: radial-gradient(120% 140% at 25% 85%, #10262b, #0a1416 70%);
  }
  .cover-4 {
    background: radial-gradient(120% 140% at 75% 80%, #2a2008, #150f06 70%);
  }

  .case-body {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    padding-bottom: 90px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 70px;
  }

  .case-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin-bottom: 14px;
  }

  .case-block p {
    color: var(--text-muted);
    font-size: 15.5px;
    line-height: 1.75;
  }

  .case-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .case-cta h2 {
    font-size: clamp(26px, 3.4vw, 36px);
  }

  @media (max-width: 900px) {
    .case-body {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
