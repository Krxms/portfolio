---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tile from '../components/Tile.astro';
import FrostedCTA from '../components/FrostedCTA.astro';
import Hero from '../components/Hero.astro';
import LavaBackground from '../components/LavaBackground.astro';
import ProgressiveBlur from '../components/ProgressiveBlur.astro';
import HeroStage from '../components/HeroStage.astro';
import Manifesto from '../components/Manifesto.astro';
import ServiceCards from '../components/ServiceCards.astro';
// import ProjectTeaser from '../components/ProjectTeaser.astro';
import Process from '../components/Process.astro';
import AboutMini from '../components/AboutMini.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyCta from '../components/StickyCta.astro';
import '../styles/scenes.css';

const steps = [
  {
    title: 'Échange',
    text: 'Vous me parlez de votre activité, de vos clients et de ce que le site doit vous apporter. Par téléphone, en visio ou par e-mail.',
  },
  {
    title: 'Audit et cadrage',
    text: 'Pour une refonte, je commence par auditer l’existant. Après la signature du devis et l’acompte, nous fixons la structure : quelles pages, avec quel contenu.',
  },
  {
    title: 'Conception',
    text: 'Je dessine les écrans pour ordinateur et mobile. Vous réagissez, j’ajuste jusqu’à votre validation.',
  },
  {
    title: 'Réalisation',
    text: 'Je construis le site, je le teste sur plusieurs écrans et je le mets en ligne. Le solde est dû à la livraison.',
  },
];
---

<BaseLayout
  title="Antoine Bruneau"
  description="Webdesigner et designer UX/UI freelance dans les Yvelines : création de site, refonte et audit UX/UI. À distance partout en France. Devis gratuit."
>
  <div class="curtain">
  <div class="hero-zone">
    <LavaBackground />
    <ProgressiveBlur toward="bottom" />
    <Hero />
    <div class="wrap">
      <HeroStage />
    </div>
  </div>

  <Manifesto />
  </div>

  <Tile id="services" title="Ce que je peux faire pour vous" sub="Votre site n’existe pas encore, il a vieilli, ou vous voulez d’abord un avis.">
    <ServiceCards />
    <div class="cards-cta">
      <FrostedCTA href="/contact/">Décrire mon projet</FrostedCTA>
    </div>
  </Tile>

  {/* Dernier projet : désactivé pour l'instant, à réactiver en décommentant l'import et la ligne ci-dessous.
  <ProjectTeaser /> */}

  <Tile id="methode" title="Comment se passe un projet" sub="Quatre étapes. Chacune se termine par quelque chose que vous pouvez valider.">
    <Process steps={steps} scene />
    <p class="proc-after">
      <strong>Après la livraison :</strong> une prise en main de votre site, puis un suivi mensuel si vous le souhaitez.
    </p>
  </Tile>

  <div class="dark-zone">
    <AboutMini />

    <FinalCta
      title="Parlons de votre projet"
      text="Quelques lignes suffisent : votre activité, ce que vous voulez changer. Je réponds sous 24 h ouvrées, et ce premier échange est gratuit."
      label="Décrire mon projet"
    />
  </div>

  <StickyCta />
</BaseLayout>

<script>
  import '../scripts/scenes.js';
</script>
