---
import BaseLayout from '../layouts/BaseLayout.astro';
import { plain } from '../lib/fmt';
import Tile from '../components/Tile.astro';
import Hero from '../components/Hero.astro';
import HeroAmbient from '../components/HeroAmbient.astro';
import HeroMobileArt from '../components/HeroMobileArt.astro';
import Manifesto from '../components/Manifesto.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ProjectTeaser from '../components/ProjectTeaser.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import AboutMini from '../components/AboutMini.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyCta from '../components/StickyCta.astro';
import '../styles/scenes.css';

const faq = [
  {
    q: 'Combien coûte un site ou une interface ?',
    a: 'Cela dépend du nombre de pages ou d’écrans, des contenus et des fonctionnalités. Après un premier échange gratuit, vous recevez un devis détaillé : vous savez ce qui est inclus avant de vous engager.',
  },
  {
    q: 'Combien de temps faut-il ?',
    a: 'Cela dépend de votre projet et de la rapidité de vos retours. Le calendrier est fixé avec vous dans le devis.',
  },
  {
    q: 'Que dois-je préparer avant de vous écrire ?',
    a: 'Rien d’obligatoire, pas même un cahier des charges. Une phrase sur ce que le projet doit permettre, quelques exemples qui vous plaisent et votre échéance suffisent pour démarrer.',
  },
  {
    q: 'Mon site ou mon logiciel existe déjà : par où commencer ?',
    a: 'Pour un devis de refonte, une lecture rapide de votre site suffit, gratuite et sans rapport écrit. Pour un diagnostic détaillé avant de décider, vous pouvez commander un audit UX/UI.',
  },
  {
    q: 'Avec quelles technologies travaillez-vous ?',
    a: 'Celles qui servent votre projet : WordPress, Webflow, du no-code quand il suffit, du code sur mesure (HTML, CSS, JavaScript, React, Astro) quand il le faut. Je vous recommande ce qui convient à votre budget et à votre autonomie.',
  },
];

// Les questions affichées dans la FAQ de l'accueil, mot pour mot : les moteurs et les assistants IA peuvent les citer telles quelles.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://antoinebruneau.fr/#faq',
  inLanguage: 'fr-FR',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: plain(item.q),
    acceptedAnswer: { '@type': 'Answer', text: plain(item.a) },
  })),
};
---

<BaseLayout
  schema={schema}
  title="Antoine Bruneau"
  description="Conception et réalisation de sites web, conception UX/UI d’interfaces de logiciels métier, refonte et audit. Île-de-France et à distance."
>
  {/* Accueil, en alternance clair / sombre : la Hero (clair), les offres (sombre : elles passent par-dessus la Hero, comme le faisait le
      manifeste), l'aperçu du projet (clair), la démarche (sombre), Qui suis-je (clair), puis la FAQ et l'appel final (sombres). */}
  <div class="curtain">
  <div class="hero-zone hero-zone--atelier neg-on">
    <HeroAmbient />
    {/* Le texte de la Hero passe avant l'illustration du téléphone dans le HTML : le navigateur le lit et l'affiche sans attendre les 40 Ko de
        tracés de l'illustration. L'empilement ne change pas : l'illustration reste derrière le texte (z-index: -1, HeroMobileArt.astro). */}
    <Hero />
    <HeroMobileArt />
  </div>

  <Tile id="services" tone="dark" title="Un site pour votre activité.\nDes interfaces pour vos métiers.">
    <ServiceCards />
  </Tile>
  </div>

  <ProjectTeaser brief progress />

  <Reviews />

  <Manifesto />

  {/* Qui suis-je, sur le papier clair : une respiration entre la démarche (sombre) et la FAQ et le contact (sombres) */}
  <AboutMini tone="light" />

  <div class="dark-zone">
    <Tile id="faq" tone="dark" title="Questions fréquentes" sub={'Ce que l’on me demande le plus souvent.\nUne autre question ? Écrivez-moi.'}>
      <Faq items={faq} />
    </Tile>

    <FinalCta
      title="Parlons de ce que vous voulez construire."
      text="Un site à créer, une interface à concevoir ou un existant à faire évoluer ?"
      label="Parlons de votre projet"
    />
  </div>

  <StickyCta />
</BaseLayout>

<script>
  import '../scripts/scenes.js';
</script>
