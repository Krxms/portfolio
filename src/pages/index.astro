---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tile from '../components/Tile.astro';
import FrostedCTA from '../components/FrostedCTA.astro';
import HeroStage from '../components/HeroStage.astro';
import AuditMock from '../components/AuditMock.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyCta from '../components/StickyCta.astro';
import './index.css';

const services = [
  {
    tone: 'warm',
    span: 'wide',
    kicker: 'Sites web',
    title: 'Création de site web',
    text: 'Je dessine les pages, puis je les intègre et je les mets en ligne. Vous recevez un site qui fonctionne, pas seulement des maquettes.',
    gets: ['Maquettes', 'Site en ligne'],
    href: '/creation-site-web/',
  },
  {
    tone: 'dark',
    span: 'narrow',
    kicker: 'Diagnostic',
    title: 'Audit UX/UI',
    text: "J'examine un site ou un produit existant et je classe les corrections par ordre de priorité.",
    gets: ['Constats annotés', 'Recommandations'],
    href: '/audit-ux-ui/',
  },
  {
    tone: 'lilac',
    span: 'narrow',
    kicker: 'Produits',
    title: 'Design UX/UI de produit',
    text: 'Parcours, écrans et composants pour une application ou un outil en ligne, à partir de ce que vos utilisateurs doivent réussir à faire.',
    gets: ['Parcours', 'Écrans', 'Composants'],
    href: '/contact/?sujet=ux',
  },
  {
    tone: 'sage',
    span: 'wide',
    kicker: 'Dans la durée',
    title: 'Accompagnement mensuel',
    text: 'Je reste votre designer de référence : ajustements, nouvelles pages, arbitrages, au fil des mois.',
    gets: ['Suivi régulier', 'Évolutions'],
    href: '/contact/?sujet=suivi',
  },
];

const zones = [
  ['Yvelines', '78'],
  ["Val-d'Oise", '95'],
  ['Oise', '60'],
  ['Paris', '75'],
  ['Île-de-France', ''],
  ['Toute la France', ''],
];

const steps = [
  {
    title: 'Échange',
    text: 'Nous parlons de votre activité, de vos clients et de ce que le site doit permettre, par téléphone, visio ou email.',
    gets: 'un devis détaillé et gratuit : périmètre, délai indicatif, prix.',
  },
  {
    title: 'Cadrage',
    text: "Une fois le devis signé et l'acompte versé, nous fixons la structure : quelles pages, quel contenu sur chacune.",
    gets: "l'arborescence et la liste des contenus attendus.",
  },
  {
    title: 'Conception',
    text: "Je dessine les écrans pour ordinateur et pour mobile. Vous me donnez vos retours, j'ajuste.",
    gets: 'des maquettes à valider.',
  },
  {
    title: 'Réalisation',
    text: "J'intègre, je teste sur plusieurs écrans et je mets en ligne. Le solde est dû à la livraison.",
    gets: 'le site en ligne. Les droits sur les créations et le code vous sont cédés une fois les factures réglées.',
  },
];

const faq = [
  {
    q: 'Combien ça coûte ?',
    a: "Je ne publie pas de grille : deux projets qui portent le même nom peuvent demander des semaines de travail très différentes. Après un premier échange gratuit, je vous envoie un devis détaillé avec ce qui est inclus, le délai et le prix.",
  },
  {
    q: 'Combien de temps faut-il ?',
    a: 'Le devis indique un délai indicatif. Il dépend surtout de la taille du projet, et de la rapidité de vos retours et de vos contenus.',
  },
  {
    q: 'Qui fait quoi ?',
    a: "Je conçois, j'intègre et je mets en ligne. Vous fournissez les informations, les textes, les images et les validations.",
  },
  {
    q: 'À qui appartient le site ?',
    a: "À vous, une fois les factures réglées. Les droits sur les créations graphiques et le code vous sont cédés au paiement intégral, sauf mention contraire au devis. Je peux citer la réalisation comme référence, sauf si vous préférez que non.",
  },
  {
    q: 'Et si je veux modifier quelque chose après la livraison ?',
    a: "Les petites évolutions se chiffrent à part. Si vous voulez un designer disponible dans la durée, c'est le rôle de l'accompagnement mensuel.",
  },
  {
    q: 'Travaillez-vous avec des entreprises hors des Yvelines ?',
    a: "Oui. Je suis basé à Guitrancourt, dans les Yvelines, mais je travaille à distance par visio, téléphone et email avec des clients du Val-d'Oise, de l'Oise, de Paris, d'Île-de-France ou d'ailleurs en France.",
  },
  {
    q: 'Et si le projet ne convient finalement pas ?',
    a: "Avant la signature du devis, vous ne vous engagez à rien. Après le démarrage, le travail déjà réalisé reste dû, comme l'indiquent les CGV.",
  },
];
---

<BaseLayout
  title="Antoine Bruneau"
  description="Webdesigner et designer UX/UI freelance à Guitrancourt (Yvelines). Sites sur mesure, interfaces et audits UX/UI, à distance partout en France. Devis clair, un seul interlocuteur."
>
  <section class="hero wrap" data-sticky-watch>
    <p class="hero-role">Designer UX/UI &amp; Webdesigner</p>
    <h1><span class="title-dark">Votre site,</span><br /><em>sur-mesure</em></h1>
    <p class="hero-sub">
      Identité de marque, interfaces et sites sur-mesure :<br />
      je vous accompagne à chaque étape dans la création de votre projet.
    </p>
    <div class="hero-actions">
      <FrostedCTA href="/contact/">Décrire mon projet</FrostedCTA>
      <a class="hero-link" href="/audit-ux-ui/">Faire auditer mon site</a>
    </div>
    <p class="hero-note">Basé dans les Yvelines · Île-de-France et toute la France · Devis gratuit</p>
  </section>

  <div class="wrap">
    <HeroStage />
  </div>

  <section class="facts wrap" aria-label="Repères">
    <dl class="facts-list">
      <div class="facts-cell"><dt>Réponse</dt><dd>sous 24 h ouvrées</dd></div>
      <div class="facts-cell"><dt>Devis</dt><dd>gratuit et détaillé</dd></div>
      <div class="facts-cell">
        <dt>Statut</dt>
        <dd>
          Entrepreneur individuel,{' '}
          <a class="link" href="https://annuaire-entreprises.data.gouv.fr/entreprise/788566719" rel="noopener">SIREN 788 566 719</a>
        </dd>
      </div>
      <div class="facts-cell">
        <dt>Paiement</dt>
        <dd>acompte, puis solde à la livraison (<a class="link" href="/cgv/">CGV</a>)</dd>
      </div>
    </dl>
  </section>

  <Tile id="services" title="Ce que je peux faire pour vous" sub="Quatre manières de travailler ensemble, selon où en est votre projet.">
    <ul class="bento" role="list">
      {
        services.map((s) => (
          <li class={`bento-item bento-item--${s.span}`}>
            <a class={`bento-tile bento-tile--${s.tone}`} href={s.href} data-glow>
              <p class="bento-kicker">{s.kicker}</p>
              <h3>{s.title}</h3>
              <p class="bento-text">{s.text}</p>
              <ul class="bento-gets" role="list">
                {s.gets.map((g) => (
                  <li>{g}</li>
                ))}
              </ul>
              <span class="bento-more" aria-hidden="true">En savoir plus</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Tile>

  <Tile
    tone="dark"
    id="audit"
    label="Audit UX/UI"
    title="Ce qu'on reçoit après un audit"
    sub="Chaque problème repéré est illustré, expliqué et accompagné d'une correction, du plus urgent au plus secondaire."
  >
    <a slot="actions" class="more" href="/audit-ux-ui/">Voir ce que contient un audit</a>
    <div class="audit-wrap">
      <AuditMock />
      <p class="audit-caption">
        Vous repérez les points qui posent problème et vous savez par quoi commencer. Je ne peux pas dire ce que font vos
        visiteurs sans vos statistiques : l'audit s'appuie sur ce que je constate en parcourant le site ou le produit.
      </p>
    </div>
  </Tile>

  <Tile id="methode" title="Comment se passe un projet" sub="Quatre étapes, avec quelque chose de concret à la fin de chacune.">
    <Process steps={steps} />
  </Tile>

  <Tile
    id="approche"
    title="Ma façon de travailler"
    sub="Je fais moi-même les maquettes et l'intégration : personne n'a à retranscrire mon travail d'une étape à l'autre."
  >
    <div class="fit">
      <div class="fit-col">
        <h3>Pour qui ça marche bien</h3>
        <ul>
          <li>Vous voulez un seul interlocuteur du début à la fin.</li>
          <li>Vous savez expliquer ce que vous vendez, même sans vocabulaire de designer.</li>
          <li>Vous avez du temps pour les retours et pour fournir vos contenus.</li>
        </ul>
      </div>
      <div class="fit-col">
        <h3>Pour qui ça marche moins bien</h3>
        <ul>
          <li>Vous cherchez le prix le plus bas, ou un site en quelques jours.</li>
          <li>Vous voulez un prix ferme sans aucun échange préalable.</li>
          <li>Vous préférez ne pas intervenir pendant le projet.</li>
        </ul>
      </div>
    </div>
  </Tile>

  <Tile
    id="zones"
    title="Basé dans les Yvelines, à distance partout en France"
    sub="Je suis à Guitrancourt (78) et je travaille par visio, téléphone et email avec des clients où qu'ils soient. Pour les entreprises voisines, une rencontre est plus simple à organiser."
  >
    <ul class="zones" role="list">
      {
        zones.map(([name, code]) => (
          <li class="zone">
            <span>{name}</span>
            {code && <small>{code}</small>}
          </li>
        ))
      }
    </ul>
    <p class="zones-note">
      Création de site, design UX/UI et audit suivent la même méthode, que vous soyez dans les Yvelines, le Val-d'Oise,
      l'Oise, à Paris ou ailleurs.
    </p>
  </Tile>

  <Tile id="cadre" title="Argent, délais, droits" sub="Ce qui est écrit avant que le travail commence.">
    <div class="terms glass">
      <dl>
        <div><dt>Statut</dt><dd>Entrepreneur individuel</dd></div>
        <div><dt>SIREN</dt><dd>788 566 719</dd></div>
        <div><dt>Devis</dt><dd>Détaillé et gratuit, à valider avant tout démarrage</dd></div>
        <div><dt>Acompte</dt><dd>À la commande, sauf accord contraire au devis</dd></div>
        <div><dt>Solde</dt><dd>À la livraison, sauf accord contraire au devis</dd></div>
        <div><dt>Droits</dt><dd>Cédés au paiement intégral</dd></div>
      </dl>
    </div>
    <p class="terms-links">
      <a class="more" href="/cgv/">Lire les CGV</a>
      <a class="more" href="/mentions-legales/">Mentions légales</a>
    </p>
  </Tile>

  <Tile id="faq" title="Vos questions">
    <Faq items={faq} />
  </Tile>

  <FinalCta
    title="Parlons de votre projet"
    text="Écrivez-moi quelques lignes sur votre projet. Je réponds sous 24 h ouvrées, et ce premier échange ne coûte rien."
    label="Décrire mon projet"
  />

  <StickyCta />
</BaseLayout>
