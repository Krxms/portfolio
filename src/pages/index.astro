---
import BaseLayout from '../layouts/BaseLayout.astro';
// GlassCTA (effet liquid-glass SVG) mis en standby au profit de FrostedCTA
// (verre dépoli en CSS pur) — voir src/components/GlassCTA.astro pour le retour en arrière.
import FrostedCTA from '../components/FrostedCTA.astro';
import './index.css';
---

<BaseLayout
  title="Antoine Bruneau"
  description="Le portfolio d'Antoine Bruneau, designer UX/UI & graphiste indépendant, fait peau neuve. De retour très prochainement."
>
  <section class="hero wrap">
    <p class="hero-role">Designer UX/UI &amp; Webdesigner</p>
    <span class="label">Site en construction - disponible</span>
    <h1><span class="title-dark">Votre site,</span><br /><em>sur-mesure</em></h1>
    <p class="hero-sub">
      Identité de marque, interfaces et sites sur-mesure :<br />
      je vous accompagne à chaque étape dans la création de votre projet.
    </p>
    <FrostedCTA href="/contact">
      Parlons de votre projet
    </FrostedCTA>
  </section>
</BaseLayout>
