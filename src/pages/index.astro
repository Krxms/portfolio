---
import BaseLayout from '../layouts/BaseLayout.astro';
import './index.css';
---

<BaseLayout
  title="Antoine Bruneau"
  description="Le portfolio d'Antoine Bruneau, designer UX/UI & graphiste indépendant, fait peau neuve. De retour très prochainement."
>
  <section class="hero wrap">
    <span class="label">Prochainement</span>
    <div class="hero-intro">
      <h1><span class="hello">Hello</span><br /><em>Moi c'est Antoine</em></h1>
      <p class="hero-role">Designer UX/UI &amp; Webdesigner</p>
    </div>
    <p class="hero-sub">
      Identité de marque, interfaces et sites sur-mesure : je vous accompagne à chaque étape dans la création de votre projet.
    </p>
    <a class="btn btn-primary btn-glass" href="mailto:antoine.bruneau@protonmail.com?subject=Votre%20projet">
      Me contacter <span class="btn-arrow">→</span>
    </a>
  </section>
</BaseLayout>
