---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tile from '../components/Tile.astro';
import FrostedCTA from '../components/FrostedCTA.astro';
import Hero from '../components/Hero.astro';
import LavaBackground from '../components/LavaBackground.astro';
import ProgressiveBlur from '../components/ProgressiveBlur.astro';
import HeroStage from '../components/HeroStage.astro';
import Manifesto from '../components/Manifesto.astro';
import ServiceCards from '../components/ServiceCards.astro';
// import ProjectTeaser from '../components/ProjectTeaser.astro';
import Process from '../components/Process.astro';
import AboutMini from '../components/AboutMini.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyCta from '../components/StickyCta.astro';
import LinkUnder from '../components/LinkUnder.astro';

const steps = [
  {
    title: 'Échange',
    text: 'Nous parlons de votre activité, de vos clients et de ce que le site doit permettre, par téléphone, visio ou email.',
  },
  {
    title: 'Audit et cadrage',
    text: "Pour une refonte, je commence par auditer l'existant. Une fois le devis signé et l'acompte versé, nous fixons la structure : quelles pages, quel contenu sur chacune.",
  },
  {
    title: 'Conception',
    text: "Je dessine les écrans pour ordinateur et pour mobile. Vous me donnez vos retours, j'ajuste.",
  },
  {
    title: 'Réalisation',
    text: "J'intègre, je teste sur plusieurs écrans et je mets en ligne. Le solde est dû à la livraison.",
  },
];
---

<BaseLayout
  title="Antoine Bruneau"
  description="Webdesigner et designer UX/UI freelance dans les Yvelines : création de site, refonte et audit UX/UI. À distance partout en France. Devis gratuit."
>
  <div class="hero-zone">
    <LavaBackground />
    <ProgressiveBlur toward="bottom" />
    <Hero />
    <div class="wrap">
      <HeroStage />
    </div>
  </div>

  <Manifesto />

  <Tile id="services" title="Ce que je peux faire pour vous" sub="Trois manières de travailler ensemble, selon où en est votre projet.">
    <ServiceCards />
    <div class="cards-cta">
      <FrostedCTA href="/contact/">Décrire mon projet</FrostedCTA>
      <LinkUnder href="/audit-ux-ui/" label="Commencer par un audit" />
    </div>
  </Tile>

  {/* Dernier projet : désactivé pour l'instant, à réactiver en décommentant l'import et la ligne ci-dessous.
  <ProjectTeaser /> */}

  <Tile id="methode" title="Comment se passe un projet" sub="Quatre étapes, avec quelque chose de concret à la fin de chacune.">
    <Process steps={steps} />
    <p class="proc-after">
      <strong>Après la livraison :</strong> une prise en main de votre site, et un accompagnement mensuel si vous en avez envie.
    </p>
  </Tile>

  <div class="dark-zone">
    <AboutMini />

    <FinalCta
      title="Parlons de votre projet"
      text="Écrivez-moi quelques lignes sur votre projet. Je réponds sous 24 h ouvrées, et ce premier échange ne coûte rien."
      label="Décrire mon projet"
    />
  </div>

  <StickyCta />
</BaseLayout>
