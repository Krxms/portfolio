---
import R from '../components/R.astro';
import SceneArt from '../components/SceneArt.astro';
import { plain } from '../lib/fmt';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tile from '../components/Tile.astro';
import PageHero from '../components/PageHero.astro';
import ExplodedProcess from '../components/ExplodedProcess.astro';
import Faq from '../components/Faq.astro';
import LinkUnder from '../components/LinkUnder.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyCta from '../components/StickyCta.astro';
import '../styles/scenes.css';
// Même langage visuel et mêmes composants que les pages « Création » et « Refonte » : on réutilise leur feuille de style (préfixe cs-)
import './creation-site-web.css';

const site = 'https://antoinebruneau.fr';
const description =
  'Revue experte UX/UI d’un site ou d’un logiciel : parcours, navigation, mobile et accessibilité (référentiel WCAG). Constats et recommandations classées.';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${site}/audit-ux-ui/#audit`,
      name: 'Audit UX/UI',
      serviceType: 'Audit UX/UI',
      description:
        "Revue experte d'un site ou d'une interface, accessibilité comprise avec les WCAG comme référentiel, constats illustrés, recommandations classées et restitution commentée.",
      url: `${site}/audit-ux-ui/`,
      inLanguage: 'fr-FR',
      areaServed: { '@type': 'Country', name: 'France' },
      provider: { '@type': 'ProfessionalService', '@id': `${site}/#service`, name: 'Antoine Bruneau' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Audit UX/UI', item: `${site}/audit-ux-ui/` },
      ],
    },
  ],
};

// Trois situations où un audit sert : une phrase chacune, sous la liste des points examinés.
const cases = [
  { t: 'Avant de refaire', d: 'Vous hésitez entre retoucher et reconstruire : l’audit dit ce qui mérite d’être refait et ce qui peut rester.' },
  { t: 'Peu de demandes', d: 'Le trafic est là, personne n’écrit : l’audit repère ce qui peut freiner vos visiteurs dans leur parcours.' },
  { t: 'Un produit qu’on ne voit plus', d: 'À force de le côtoyer, on s’y habitue : un regard neuf remarque ce qui gêne vos utilisateurs.' },
];

// Les cinq points examinés, dans l'ordre des repères numérotés de la scène (voir .cs-pin).
const examined = [
  { t: 'Les parcours qui comptent', d: 'De la page d’arrivée jusqu’à l’action attendue : contact, achat, inscription, formulaires compris.' },
  { t: 'La clarté des pages', d: 'Titres, hiérarchie, vocabulaire, appels à l’action : comprend-on en quelques secondes ce que la page propose ?' },
  { t: 'La navigation et la structure', d: 'Retrouve-t-on ce que l’on cherche, et sans effort ?' },
  { t: 'L’affichage sur mobile', d: 'Lisibilité, zones à toucher, longueur des pages.' },
  { t: 'L’accessibilité et la cohérence', d: 'Contrastes mesurés, usage au clavier, libellés des champs, composants qui se ressemblent quand ils font la même chose.' },
];

const steps = [
  { title: 'Cadrage', text: 'Vos objectifs, vos utilisateurs, les parcours à examiner et les données que vous avez déjà.', gets: 'Un périmètre écrit, dans le devis.' },
  { title: 'Revue', text: 'Je parcours le site ou le produit comme le ferait un utilisateur, puis je relève chaque problème avec une capture.', gets: 'Une liste de constats illustrés.' },
  { title: 'Priorisation', text: 'Chaque recommandation est classée selon son effet attendu et l’effort qu’elle demande.', gets: 'Un ordre d’action clair.' },
  { title: 'Restitution', text: 'Je vous présente les résultats et je réponds à vos questions.', gets: 'Le rapport commenté.' },
];

// Ce que contient le rapport : valable pour tout audit, quel que soit son périmètre (fixé avec vous avant le devis).
const commitments = [
  { t: 'Des constats illustrés', d: 'Chaque problème est montré par une capture annotée : vous voyez de quoi il s’agit, pas seulement une phrase.' },
  { t: 'Une recommandation par constat', d: 'Pour chaque point, une piste précise : ce qu’il faut changer, et pourquoi.' },
  { t: 'Un ordre d’action', d: 'Les recommandations sont classées selon leur effet attendu et l’effort qu’elles demandent.' },
  { t: 'Une restitution commentée', d: 'Je présente le rapport et je réponds à vos questions.' /* Le rapport est à vous : vous l’appliquez comme vous voulez. (mis en commentaire) */ },
];

// D'autres portes d'entrée : le nom, puis ce que l'offre apporte, en une phrase.
const nextOffers = [
  { t: 'Refonte de site', d: 'Gardez ce qui marche, refaites le reste.', href: '/refonte-site-web/' },
  { t: 'Création de site', d: 'Repartir d’une page blanche : un nouveau site, construit autour de votre activité.', href: '/creation-site-web/' },
  { t: 'Interfaces et logiciels', d: 'Concevoir ou faire évoluer les écrans d’un logiciel.', href: '/interfaces-logiciels/' },
];

const faq = [
  {
    q: 'Faut-il me donner des accès ?',
    a: "Souvent, l’adresse du site suffit. Pour un produit qui n’est pas public, il me faut un accès de test. Vos statistiques de fréquentation sont utiles si vous en avez.",
  },
  {
    q: "Mon produit n’est pas public, est-ce un problème ?",
    a: 'Non. Un accès de test ou de démonstration suffit ; nous réglons ce point ensemble avant le devis.',
  },
  {
    q: 'Faut-il me confier la refonte ensuite ?',
    a: 'Non. Vous êtes libre d’appliquer le rapport seul, avec votre équipe ou avec un autre prestataire.',
  },
  {
    q: 'Faut-il être en Île-de-France pour demander un audit ?',
    a: 'Non. L’audit se fait à distance, avec une restitution en visio. Je travaille en Île-de-France et à distance, partout en France.',
  },
  {
    q: 'Quel est le prix ?',
    a: 'Il dépend du périmètre. Le devis est gratuit et détaillé, envoyé après un échange sur ce que vous souhaitez faire examiner.',
  },
  {
    q: 'Combien de temps faut-il ?',
    a: 'Cela dépend du périmètre. La durée figure au devis.',
  },
];
// Les questions de la page, exactement celles qui sont affichées (aide les moteurs de réponse et les assistants IA à les citer)
schema['@graph'].push({
  '@type': 'FAQPage',
  '@id': `${site}/audit-ux-ui/#faq`,
  inLanguage: 'fr-FR',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: plain(item.q), acceptedAnswer: { '@type': 'Answer', text: plain(item.a) } })),
});
---

<BaseLayout title="Audit UX/UI de site web ou de logiciel" description={description} schema={schema}>
  <PageHero
    crumb="Audit UX/UI"
    kicker="Audit UX/UI · Site, application, logiciel"
    line1="Voir ce qui freine."
    line2="Savoir quoi changer."
    lead={'Une analyse de votre site ou de votre logiciel, avec des constats illustrés et des recommandations classées par priorité.'}
    ctaHref="/contact/?sujet=audit"
    ctaLabel="Demander un audit"
    linkHref="#livrable"
    linkLabel="Voir le rapport"
    note="Devis gratuit et détaillé · Réponse généralement sous deux jours ouvrés · 50 % de l’audit déduit si le projet suit dans les 3 mois"
  />

  <section class="tile tile--light" id="perimetre" aria-labelledby="perimetre-title">
    <div class="wrap wrap--wide tile-inner">
      <header class="tile-head">
        <p class="tile-label">Ce que j’examine</p>
        <h2 id="perimetre-title">Ce qui fonctionne, ce qui freine,<br> et ce qu’il faut revoir.</h2>
        <p class="tile-sub">Une revue structurée de vos parcours et de vos écrans.</p>
      </header>

      <!-- La scène montre une page en cours d'examen ; chaque repère orange désigne un point examiné, détaillé dans la liste dessous sous le même numéro. -->
      <div class="cs-stage cs-stage--audit" aria-hidden="true">
        <SceneArt scene="audit" />
        <span class="cs-shape cs-disc concrete"></span>
        <span class="cs-shape cs-arch concrete"></span>
        <span class="cs-shape cs-quarter concrete"></span>

        <div class="cs-site">
          <div class="cs-site-bar">
            <i></i><i></i><i></i>
            <span class="cs-addr">
              <svg viewBox="0 0 12 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M3 6V4.5a3 3 0 0 1 6 0V6M2 6h8v6H2z" /></svg>
              votre-site.fr
            </span>
            <span class="cs-live cs-live--audit">Audit en cours</span>
          </div>
          <div class="cs-site-body">
            <div class="cs-site-nav"><b></b><span></span><span></span><span></span><em></em></div>
            <div class="cs-site-hero">
              <div class="cs-site-copy">
                <strong>Votre activité, bien présentée.</strong>
                <p>Ce que vous proposez, en deux lignes.</p>
                <span class="cs-site-cta">Demander un devis</span>
              </div>
              <div class="cs-site-img"></div>
            </div>
            <div class="cs-site-cards"><i></i><i></i><i></i></div>
          </div>
        </div>

        <div class="cs-phone"><i class="cs-site-img cs-phone-hero"></i><i class="cs-phone-line"></i><i class="cs-phone-line s"></i><i class="cs-phone-btn"></i></div>

        <div class="cs-serp">
          <span class="cs-serp-url"><i></i>Constat 1 · priorité haute</span>
          <b>Le bouton d’action se perd dans la page</b>
          <i class="cs-serp-line"></i>
          <i class="cs-serp-line s"></i>
        </div>

        <div class="cs-guide">
          <span><i></i>Contraste 7,2 : 1</span>
          <span><i></i>Navigation au clavier</span>
          <span><i></i>Titres dans l’ordre</span>
        </div>

        {examined.map((_, i) => <span class={`cs-pin cs-pin--${i + 1}`}>{i + 1}</span>)}
      </div>

      <ol class="cs-deliv" role="list">
        {
          examined.map((r, i) => (
            <li>
              <span class="cs-deliv-n" aria-hidden="true">{i + 1}</span>
              <h3><R t={r.t} /></h3>
              <p><R t={r.d} /></p>
            </li>
          ))
        }
      </ol>

      {/* « Quand un audit est utile » : le prolongement de la liste. On a vu ce que j'examine, voici les trois situations où cela sert. Il ouvre aussi la page (le chapô évoque déjà ces symptômes), la scène reste donc le premier grand visuel. */}
      <div class="cs-when" id="quand">
        <h3>Quand un audit est <em>utile</em>.</h3>
        <ul class="cs-commit cs-commit--light" role="list">
          {cases.map((c) => <li><strong><R t={c.t} /></strong><p><R t={c.d} /></p></li>)}
        </ul>
      </div>
    </div>
  </section>

  <ExplodedProcess plain title="Comment je procède" sub="Quatre étapes, et à chacune quelque chose de concret à valider." steps={steps} />

  <div class="dark-zone">
    <Tile tone="dark" wide id="livrable" title="Ce que vous recevez." sub="Des constats concrets et un ordre de priorité.">
      {/* tout ce qui suit le sous-titre apparaît d'un seul bloc, en fondu, quand ses mots arrivent vers la fin (scenes.js) */}
      <div class="cs-follow">
        <ul class="cs-commit" role="list">
          {commitments.map((c) => <li><h3><R t={c.t} /></h3><p><R t={c.d} /></p></li>)}
        </ul>
        {/* la méthode et ses limites : une revue experte, ce qu'elle examine, ce qu'elle ne remplace pas, et ce qui peut suivre */}
        <div class="cs-start cs-limits">
          <h3>Une revue experte, et ce qu’elle ne remplace pas.</h3>
          <p>
            <strong>Mes références.</strong> J’examine votre interface à partir des bonnes pratiques ergonomiques (clarté, cohérence, navigation,
            prévention des erreurs) et des WCAG, que j’utilise comme référentiel de travail pour l’accessibilité : contrastes mesurés, usage au
            clavier, libellés, structure des titres.
          </p>
          <p>
            <strong>Ce que c’est.</strong> Une revue experte. Je parcours votre interface et je relève les problèmes probables, avec leur emplacement
            et une recommandation.
          </p>
          <p>
            <strong>Ce que ce n’est pas.</strong> Ni un test utilisateur, qui observe de vraies personnes utiliser votre interface ; ni un audit de
            conformité ou une certification d’accessibilité ; ni la garantie d’un résultat commercial. Quand une question mérite d’être vérifiée
            auprès de vos utilisateurs, je l’indique dans le rapport.
          </p>
          <p>
            <strong>Et après.</strong> Les recommandations sont à vous. Vous pouvez les appliquer vous-même, avec votre équipe, ou me confier les
            corrections, une refonte ou la conception de nouveaux écrans. Si ce projet est commandé dans les trois mois qui suivent la restitution,
            50 % du montant hors taxes de l’audit est déduit du nouveau devis.
          </p>
        </div>

        {/* d'autres portes d'entrée, chacune avec son bénéfice en une phrase : le nom de l'offre, puis ce qu'elle apporte */}
        <div class="cs-next">
          <p class="cs-next-label">Après l’audit</p>
          <ul role="list">
            {
              nextOffers.map((o) => (
                <li>
                  <a href={o.href}>
                    <strong><R t={o.t} /></strong>
                    <span><R t={o.d} /></span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Tile>

    <Tile id="faq" tone="dark" title="Avant de vous lancer" sub="Les questions qui reviennent le plus, en quelques lignes. Une autre vous vient ? Un message suffit.">
      <Faq items={faq} />
      <p class="cs-more"><LinkUnder href="/#faq" label="Toutes les questions" tone="light" /></p>
    </Tile>

    <FinalCta
      title="Quelle page vous inquiète ?"
      text="Indiquez l’adresse du site ou du produit et ce qui vous pose problème."
      label="Demander un audit"
      href="/contact/?sujet=audit"
    />
  </div>
  <StickyCta href="/contact/?sujet=audit" label="Demander un audit" />
</BaseLayout>

<script>
  import '../scripts/scenes.js';
</script>
