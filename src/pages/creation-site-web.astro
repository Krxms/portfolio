---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tile from '../components/Tile.astro';
import FrostedCTA from '../components/FrostedCTA.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyCta from '../components/StickyCta.astro';
import './service.css';

const site = 'https://antoinebruneau.fr';
const description =
  "Création de site internet sur mesure par un webdesigner freelance dans les Yvelines : design, intégration et mise en ligne par une seule personne, partout en France.";

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${site}/creation-site-web/#creation`,
      name: 'Création de site web sur mesure',
      serviceType: 'Création de site web',
      description:
        "Conception des pages, maquettes, intégration et mise en ligne d'un site web par un seul interlocuteur.",
      url: `${site}/creation-site-web/`,
      inLanguage: 'fr-FR',
      areaServed: { '@type': 'Country', name: 'France' },
      provider: { '@type': 'ProfessionalService', '@id': `${site}/#service`, name: 'Antoine Bruneau' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Création de site web', item: `${site}/creation-site-web/` },
      ],
    },
  ],
};

const steps = [
  { title: 'Échange gratuit', text: 'Votre activité, vos clients, ce que le site doit déclencher.', gets: 'une première lecture de votre projet.' },
  { title: 'Devis détaillé', text: 'Pages prévues, livrables, délai indicatif, prix. Vous le validez avant tout démarrage.', gets: 'un devis écrit.' },
  { title: 'Cadrage', text: "Arborescence et contenus attendus. L'acompte est versé à la commande.", gets: "l'arborescence du site." },
  { title: 'Maquettes', text: 'Les écrans, pour ordinateur et pour mobile, sont soumis à vos retours.', gets: 'des maquettes validées.' },
  { title: 'Intégration et tests', text: 'Je construis le site et je le vérifie sur plusieurs écrans.', gets: 'un site prêt à être publié.' },
  { title: 'Mise en ligne', text: 'Le site est publié. Le solde est dû à la livraison.', gets: 'le site en ligne. Les droits vous sont cédés une fois les factures réglées.' },
];

const faq = [
  {
    q: 'Combien de temps faut-il pour créer un site ?',
    a: 'Le devis indique un délai indicatif. Il dépend de la taille du site et de la rapidité de vos retours.',
  },
  {
    q: 'Combien ça coûte ?',
    a: "Le prix est fixé dans le devis, après un échange gratuit, pour un périmètre écrit. Je ne publie pas de grille, car chaque site est différent.",
  },
  {
    q: 'Dois-je fournir les textes et les images ?',
    a: "En général, oui. Je vous dis dès le cadrage ce qu'il faut préparer et sous quelle forme.",
  },
  {
    q: "Le site m'appartient-il ?",
    a: 'Oui. Les droits sur les créations graphiques et le code vous sont cédés au paiement intégral, sauf mention contraire au devis.',
  },
  {
    q: "Travaillez-vous avec des entreprises du Val-d'Oise, de l'Oise ou de Paris ?",
    a: "Oui. Je suis basé à Guitrancourt, dans les Yvelines, et je travaille avec des entreprises des Yvelines, du Val-d'Oise, de l'Oise, de Paris, d'Île-de-France et d'ailleurs en France. Les échanges se font en visio, par téléphone et par email.",
  },
  {
    q: 'Peut-on se voir ?',
    a: "Par visio d'abord. Pour une entreprise proche, une rencontre est plus simple à organiser : on en parle.",
  },
];
---

<BaseLayout title="Création de site web sur mesure freelance" description={description} schema={schema}>
  <section class="page-hero wrap" data-sticky-watch>
    <nav class="crumbs" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a><span aria-hidden="true">/</span><span aria-current="page">Création de site web</span>
    </nav>
    <h1>Création de site web sur mesure dans les Yvelines</h1>
    <p class="page-lead">
      Conçu, intégré et mis en ligne par la même personne : je dessine les pages, puis je les construis. Vous avez un seul
      interlocuteur, des Yvelines au reste de la France.
    </p>
    <div class="page-actions">
      <FrostedCTA href="/contact/?sujet=site">Demander un devis pour mon site</FrostedCTA>
    </div>
    <dl class="brief glass">
      <div><dt>Interlocuteur</dt><dd>un seul, du début à la fin</dd></div>
      <div><dt>Devis</dt><dd>gratuit, après un premier échange</dd></div>
      <div><dt>Paiement</dt><dd>acompte, puis solde à la livraison</dd></div>
    </dl>
  </section>

  <Tile id="deroule" title="Du premier échange à la mise en ligne">
    <Process steps={steps} />
  </Tile>

  <Tile
    id="livrables"
    title="Ce que vous recevez"
    sub="Le devis écrit précisément ce qui est inclus : nombre de pages, fonctionnalités, tours de retours. Tout ce qui n'y figure pas est chiffré avant d'être réalisé."
  >
    <ul class="when when--list" role="list">
      <li>L'arborescence du site.</li>
      <li>Les maquettes validées.</li>
      <li>Le site intégré, adapté aux écrans d'ordinateur, de tablette et de téléphone.</li>
      <li>La mise en ligne.</li>
      <li>Les balises de base pour les moteurs de recherche : titres et descriptions de pages.</li>
      <li>Les droits sur les créations graphiques et le code, cédés au paiement intégral des factures.</li>
    </ul>
    <p class="also">
      De votre côté, prévoyez les textes, les images et les validations : les délais annoncés en dépendent.
    </p>
  </Tile>

  <Tile
    id="ensuite"
    title="Après la livraison"
    sub="Vous gérez le site seul, vous me demandez des évolutions ponctuelles sur devis, ou vous passez à un accompagnement mensuel où je reste votre designer de référence."
  >
    <p class="also">
      Pour un site existant à améliorer avant une refonte, vous pouvez aussi commencer par
      <a class="more" href="/audit-ux-ui/">un audit UX/UI</a>.
    </p>
  </Tile>

  <Tile id="faq" title="Questions">
    <Faq items={faq} />
  </Tile>

  <FinalCta
    title="Un site à créer ou à refaire ?"
    text="Décrivez votre activité et ce que vous attendez du site. Réponse sous 24 h ouvrées."
    label="Demander un devis pour mon site"
    href="/contact/?sujet=site"
  />
  <StickyCta href="/contact/?sujet=site" />
</BaseLayout>
