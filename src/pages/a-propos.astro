---
import BaseLayout from '../layouts/BaseLayout.astro';

const values = [
  {
    title: 'Comprendre avant de dessiner',
    text: "Un écran qui plaît sur le moment mais ne sert pas l'objectif du client ne m'intéresse pas. Je commence toujours par le problème, jamais par l'interface.",
  },
  {
    title: 'Dire non quand il faut',
    text: "Je préfère refuser un projet qui ne me correspond pas — ou dire franchement qu'une idée ne marchera pas — plutôt que d'encaisser et de mal faire.",
  },
  {
    title: 'Rester dans le concret',
    text: "Une maquette qui ne peut pas se coder n'est qu'un dessin. Je conçois en sachant ce qu'il faudra construire ensuite — parce que je le construis souvent moi-même.",
  },
];
---

<BaseLayout
  title="À propos"
  description="Antoine Bruneau, designer UX/UI & graphiste indépendant — parcours, méthode et valeurs."
>
  <section class="section about-hero">
    <div class="wrap">
      <div class="about-grid reveal">
        <div class="portrait-frame">
          <span class="portrait-placeholder">Photo à ajouter</span>
        </div>
        <div>
          <div class="eyebrow">À propos</div>
          <h1>Antoine Bruneau</h1>
          <p class="role">Designer UX/UI &amp; graphiste indépendant</p>
          <p class="bio-placeholder">
            [Quelques lignes sur ton parcours : où tu as appris le design, ce qui t'a mené au freelance,
            le type de projet qui te fait vibrer. Deux ou trois phrases suffisent — c'est ce paragraphe
            que les visiteurs liront pour savoir à qui ils ont affaire.]
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">Ma méthode en trois convictions</div>
        <h2>Ce qui ne change pas d'un projet à l'autre.</h2>
      </div>
      <div class="values-list reveal">
        {values.map((value, i) => (
          <div class="value-item">
            <span class="value-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{value.title}</h3>
              <p>{value.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-cta">
    <div class="wrap reveal">
      <h2>On travaille ensemble ?</h2>
      <a href="/contact" class="btn btn-primary">Discutons de votre projet <span class="btn-arrow">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding-top: 170px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 56px;
    align-items: center;
  }

  .portrait-frame {
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    border: 1px dashed var(--border-strong);
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .portrait-placeholder {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-faint);
    letter-spacing: 0.04em;
    padding: 0 20px;
  }

  h1 {
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.05;
    margin-top: 4px;
  }

  .role {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-top: 14px;
  }

  .bio-placeholder {
    margin-top: 22px;
    padding: 18px 20px;
    border-radius: var(--radius-sm);
    border: 1px dashed var(--border-strong);
    color: var(--text-muted);
    font-size: 15.5px;
    line-height: 1.7;
    max-width: 60ch;
  }

  .values-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
    max-width: 780px;
  }

  .value-item {
    display: flex;
    gap: 28px;
    padding: 32px 0;
    border-bottom: 1px solid var(--border);
  }

  .value-num {
    font-family: var(--font-display);
    font-size: 34px;
    color: var(--text-faint);
    font-weight: 300;
    flex: none;
    width: 56px;
  }

  .value-item h3 {
    font-size: 19px;
    margin-bottom: 10px;
  }

  .value-item p {
    color: var(--text-muted);
    font-size: 15.5px;
    line-height: 1.7;
    max-width: 58ch;
  }

  .about-cta {
    text-align: center;
  }

  .about-cta .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }

  .about-cta h2 {
    font-size: clamp(28px, 3.6vw, 40px);
  }

  @media (max-width: 700px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .portrait-frame {
      max-width: 220px;
    }
    .value-item {
      gap: 18px;
    }
    .value-num {
      width: 40px;
      font-size: 26px;
    }
  }
</style>
