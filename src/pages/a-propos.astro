---
import BaseLayout from '../layouts/BaseLayout.astro';
import R from '../components/R.astro';
import { plain } from '../lib/fmt';
import Tile from '../components/Tile.astro';
import AboutHero from '../components/AboutHero.astro';
import LinkUnder from '../components/LinkUnder.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyCta from '../components/StickyCta.astro';
import '../styles/scenes.css';
import './a-propos.css';

const site = 'https://antoinebruneau.fr';
const description =
  'Un parcours entre création et conception : son, spectacle vivant, création visuelle, code, puis UX/UI, dont environ deux ans sur un logiciel SaaS métier.';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${site}/a-propos/#page`,
      url: `${site}/a-propos/`,
      name: 'À propos d’Antoine Bruneau',
      description,
      inLanguage: 'fr-FR',
      isPartOf: { '@id': `${site}/#website` },
      about: { '@id': `${site}/#person` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'À propos', item: `${site}/a-propos/` },
      ],
    },
  ],
};

/* Les questions de la page : celles qu'on se pose sur la personne avant d'écrire (les mêmes sont affichées et déclarées en données structurées) */
const faq = [
  {
    q: 'Travaillez-vous seul ?',
    a: 'Oui : vous parlez toujours à la même personne, de la première conversation à la mise en ligne. Si votre projet demande un regard complémentaire (identité de marque, rédaction), je travaille volontiers avec un spécialiste et je vous le dis dès le devis.',
  },
  {
    q: 'D’où vient votre expérience ?',
    a: 'Mon parcours a commencé dans la musique, entre composition, sound design et spectacle vivant. En parallèle, mon intérêt pour la création visuelle et les arts numériques m’a progressivement amené au développement web.\n\nJ’ai ensuite choisi de me former au développement, puis à l’UX/UI à la Wild Code School, où j’ai obtenu le titre professionnel de concepteur UI. J’ai exercé pendant deux ans comme designer UX/UI sur un logiciel SaaS de gestion de maintenance (GMAO), avant de me mettre à mon compte en 2026.',
  },
  {
    q: 'Où travaillez-vous ?',
    a: 'En Île-de-France et à distance, partout en France : visio, téléphone et e-mail suffisent à chaque étape.',
  },
];
schema['@graph'].push({
  '@type': 'FAQPage',
  '@id': `${site}/a-propos/#faq`,
  inLanguage: 'fr-FR',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: plain(item.q), acceptedAnswer: { '@type': 'Answer', text: plain(item.a) } })),
});

/* Le parcours, dans l'ordre. L'ancien employeur n'est jamais nommé sur le site : « un éditeur de logiciel ». */
const story = [
  'J’ai commencé mon parcours dans la musique, en travaillant à mon compte comme compositeur et sound designer. Cette première expérience m’a ensuite conduit vers le spectacle vivant, où j’ai exercé comme ingénieur du son, aussi bien au théâtre que dans les salles de concert.',
  'En parallèle, je me suis intéressé à la création visuelle et aux arts numériques, notamment à travers des projets associatifs mêlant différentes disciplines artistiques. C’est dans ce contexte que j’ai commencé à explorer le développement web.',
  'J’ai alors choisi d’approfondir cette pratique en me formant au développement, puis à la conception d’interfaces et à l’UX à la Wild Code School, où j’ai obtenu le titre professionnel de concepteur UI.',
  'Cette évolution m’a conduit à travailler pendant deux ans comme designer UX/UI sur un logiciel SaaS de gestion de maintenance (GMAO), destiné à des professionnels dans leur activité quotidienne.',
  'Depuis 2026, je travaille à mon compte.',
  'J’y réunis les compétences acquises au fil de ce parcours : comprendre un besoin, imaginer une réponse adaptée, concevoir des interfaces et les réaliser.',
];

const principles = [
  {
    tag: '01',
    t: 'L’utile et le beau vont ensemble',
    d: 'Une interface doit servir avant de plaire, et ce qui sert bien se remarque.',
  },
  {
    tag: '02',
    t: 'Le bon outil pour le projet',
    d: 'WordPress, Webflow, un outil no-code ou du code sur mesure : je choisis selon votre besoin, votre budget et ce que vous voulez gérer vous-même, et je vous explique pourquoi.',
  },
  {
    tag: '03',
    t: 'L’accessibilité dès le départ',
    d: 'Contrastes, navigation au clavier, textes lisibles : des critères pris en compte dès les premières maquettes, pas ajoutés à la fin.',
  },
];

// Où je travaille : les mêmes zones que « Qui suis-je » sur l'accueil.
const zones = ['Île-de-France', 'À distance, partout en France'];

// Un pictogramme par domaine : un trait blanc sur une pastille sombre (même langage que les boutons du site). Décoratifs (aria-hidden).
const domains = [
  {
    t: 'Sites web',
    d: 'Création et refonte de sites professionnels, de l’organisation des contenus à la mise en ligne. L’identité visuelle et le logo peuvent s’y ajouter lorsque le projet en a besoin.',
    href: '/creation-site-web/',
    link: 'Création de site',
    // une fenêtre de navigateur : l'arche menthe, le disque orange (les formes du logo), le texte et un bouton
    glyph:
      '<rect x="5" y="8" width="38" height="32" rx="4"/><path d="M5 16h38"/><circle cx="9.6" cy="12" r="1.1" fill="#fff" stroke="none"/><circle cx="13.6" cy="12" r="1.1" fill="#fff" stroke="none"/><path d="M10 35v-8a6 6 0 0 1 12 0v8z" fill="#a6d4ca" stroke="none"/><circle cx="31" cy="25" r="4.6" fill="#ffb27a" stroke="none"/><path d="M26 33h12M26 37h7"/>',
  },
  {
    t: 'Interfaces et logiciels',
    d: 'Conception UX/UI d’interfaces de logiciels métier, de produits SaaS et d’outils internes, en mission complète ou en renfort d’équipe.',
    href: '/interfaces-logiciels/',
    link: 'Interfaces et logiciels',
    // un tableau de bord : la barre latérale, des indicateurs, un histogramme en trois couleurs
    glyph:
      '<rect x="5" y="7" width="38" height="34" rx="4"/><path d="M16 7v34M9.5 14h3.5M9.5 20h3.5M9.5 26h3.5"/><path d="M21 15h9M34 15h4"/><rect x="21" y="30" width="4" height="7" fill="#a6d4ca" stroke="none"/><rect x="27.5" y="25" width="4" height="12" fill="#fff" stroke="none"/><rect x="34" y="20" width="4" height="17" fill="#ffb27a" stroke="none"/>',
  },
];

// Ce que je sais faire : trois groupes dans un même panneau bleu. Chacun : un titre, une ou deux rangées d'étiquettes (« skill » : savoir-faire,
// « tool » : outil), une précision. Les rangées s'alignent d'un groupe à l'autre (sous-grille, voir a-propos.css).
const skills = [
  {
    t: 'Conception et création',
    rows: [
      { label: 'Savoir-faire', k: 'skill', chips: ['Architecture de l’information', 'Parcours UX', 'Prototypage', 'Conception UI', 'Direction artistique'] },
      { label: 'Outils', k: 'tool', chips: ['Figma', 'Illustrator'] },
    ],
  },
  {
    t: 'Développement et intégration',
    rows: [{ label: 'Langages et frameworks', k: 'tool', chips: ['HTML', 'CSS / Sass', 'JavaScript', 'React', 'Astro'] }],
    more: 'Dans le cadre des projets numériques que je prends en charge directement. En renfort d’équipe, j’interviens comme designer UX/UI.',
  },
  {
    t: 'CMS et environnements de travail',
    rows: [{ label: 'CMS', k: 'tool', chips: ['WordPress', 'Webflow'] }],
    more: 'Agents IA et environnements de développement assistés, que j’utilise pour produire et vérifier mon travail, sous mon contrôle.',
  },
];
---

<BaseLayout title="À propos, concepteur numérique indépendant" description={description} schema={schema}>
  {/* pas d'entête de page classique (fil d'Ariane, boutons) : une affiche, le portrait dans une arche */}
  <AboutHero
    kicker="Antoine Bruneau, concepteur numérique"
    line1="De la création sonore"
    line2="à la conception d’interfaces."
    lead={'Un parcours entre création, technique et développement, que je réunis aujourd’hui dans mon métier de concepteur numérique.'}
    zones={zones}
    alt="Portrait d’Antoine Bruneau, concepteur numérique"
  />

  {/* le parcours, puis la façon de concevoir : les deux enchaînent sur « Ce que je conçois » */}
  <Tile id="parcours" wide title="Un parcours créatif, devenu technique." sub="Du son au numérique, puis à la conception UX/UI.">
    <div class="ap-story">
      <p class="ap-tag">Mon parcours</p>
      <div class="ap-story-text">
        {story.map((t) => <p>{t}</p>)}
      </div>
    </div>

    <h3 class="ap-sub">Ma façon de concevoir</h3>
    <ol class="ap-proofs" role="list">
      {
        principles.map((p) => (
          <li class="ap-proof">
            <p class="ap-tag">{p.tag}</p>
            <h3><R t={p.t} /></h3>
            <div class="ap-text"><p><R t={p.d} /></p></div>
          </li>
        ))
      }
    </ol>
  </Tile>

  <Tile id="domaines" title="Ce que je conçois">
    <ul class="ap-domains ap-domains--two" role="list">
      {
        domains.map((d) => (
          <li>
            <span class="ap-glyph" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={d.glyph} />
            </span>
            <div>
              <h3><R t={d.t} /></h3>
              <p><R t={d.d} /></p>
              <p class="ap-link"><LinkUnder href={d.href} label={d.link} arrow /></p>
            </div>
          </li>
        ))
      }
    </ul>
  </Tile>

  <Tile id="competences" wide title="Ce que je sais faire.">
    <div class="ap-panel panel-blue panel-blue--riso">
      <ul class="ap-skills" role="list">
        {
          skills.map((s) => (
            <li class="ap-skill">
              <h3 class="ap-g-title"><R t={s.t} /></h3>
              {s.rows.map((r, n) => (
                <div class={`ap-row ap-row--${n + 1}`}>
                  <p class="ap-row-label">{r.label}</p>
                  <ul class="ap-chips" role="list">
                    {r.chips.map((c) => <li class={`ap-chip ap-chip--${r.k}`}>{c}</li>)}
                  </ul>
                </div>
              ))}
              {s.more && <p class="ap-skill-more"><R t={s.more} /></p>}
            </li>
          ))
        }
      </ul>
    </div>
  </Tile>

  <div class="dark-zone">
    <Tile id="faq" tone="dark" title="Avant de me contacter" sub={'Les questions qui reviennent le plus, en quelques lignes.\nUne autre vous vient ? Un message suffit.'}>
      <Faq items={faq} />
      <p class="ap-more"><LinkUnder href="/#faq" label="Toutes les questions" tone="light" /></p>
    </Tile>

    <FinalCta
      title="Échangeons sur votre besoin."
      text="Quelques lignes suffisent : votre activité, ce que vous voulez construire ou faire évoluer."
      label="Échanger sur mon besoin"
    />
  </div>

  <StickyCta />
</BaseLayout>

<script>
  import '../scripts/scenes.js';
</script>
