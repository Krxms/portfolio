---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import '../styles/textures.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/glass.css';
import '../styles/cta.css';
import '../styles/motion.css';
import '../styles/matiere.css';
import '../styles/mobile-heads.css';
import '../styles/perf.css';
// Les textures de la Hero (béton, mouchetures, grès). Importées en « ?url » : même fichier, même nom (avec empreinte) que dans les CSS.
import concreteZoom from '../assets/riso/concrete-zoom.webp?url';
import filmGrain from '../assets/riso/film-grain.webp?url';
import stoneware from '../assets/riso/stoneware.webp?url';
import grain from '../assets/riso/grain.webp?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: object;
  /** Image de partage (chemin depuis la racine) */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  noindex = false,
  schema,
  image = '/og-image.jpg',
  imageAlt = 'Antoine Bruneau, concepteur numérique indépendant : sites web, interfaces et logiciels.',
} = Astro.props;
const isHome = Astro.url.pathname === '/';
// Les textures de la Hero et des formes (béton, mouchetures, grès, grain), préchargées sur TOUTES les pages. Les deux grains fins des panneaux bleus
// (grain-soft, speck) sont, eux, intégrés au CSS en base 64 (voir astro.config.mjs) : ils sont là dès la première image, sans requête. Aucune surface
// n'est cachée en attendant : la promesse window.__txReady ne sert qu'au loader de l'accueil.
// Critiques : le papier de la page et le grain de la Hero, seuls à devoir être là à la première image (ils décident aussi du moment où le loader de l'accueil
// se lève). Secondaires : les textures des formes, préchargées avec une priorité basse pour ne pas retarder le CSS, les polices ni le texte.
const heroTextures = [stoneware, filmGrain];
const lateTextures = [concreteZoom, grain];
const textureGate =
  "(function(){var textures=matchMedia(\"(max-width: 700px)\").matches?[]:" + JSON.stringify(heroTextures) + ";var res,p=new Promise(function(r){res=r});window.__txReady=p;var over=false,left=textures.length,done=function(){if(over)return;over=true;res()};if(!left)done();setTimeout(done,2500);textures.forEach(function(u){var i=new Image();i.src=u;var ok=function(){if(--left===0)done()};if(i.decode){i.decode().then(ok,ok)}else{i.onload=i.onerror=ok}})})();";
const navProgress =
  "(function(){var d=document.documentElement;d.classList.add('is-loading');addEventListener('load',function(){d.classList.remove('is-loading');var on=false,go=function(){if(!on){on=true;d.classList.add('tx-in');var s=document.createElement('style');s.textContent=`@font-face { font-family: 'Be Vietnam Pro'; font-style: normal; font-weight: 700; font-display: swap; src: url('/fonts/be-vietnam-pro-700.woff2') format('woff2');}@font-face { font-family: 'Be Vietnam Pro'; font-style: italic; font-weight: 400; font-display: swap; src: url('/fonts/be-vietnam-pro-400-italic.woff2') format('woff2');}@font-face { font-family: 'Inter'; font-style: normal; font-weight: 100 900; font-display: swap; src: url('/fonts/inter-variable.woff2') format('woff2');}`;document.head.appendChild(s)}};if(document.querySelector('.er-code'))go();setTimeout(go,3000);try{var seen=false;new PerformanceObserver(function(){if(!seen){seen=true;setTimeout(go,300)}}).observe({type:'largest-contentful-paint',buffered:true})}catch(e){setTimeout(go,600)}});addEventListener('pageshow',function(e){if(e.persisted){d.classList.remove('is-loading');d.classList.add('tx-in')}});document.addEventListener('click',function(e){var a=e.target&&e.target.closest&&e.target.closest('a[href]');if(!a||e.defaultPrevented||e.button||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey||(a.target&&a.target!=='_self')||a.hasAttribute('download'))return;var u;try{u=new URL(a.href,location.href)}catch(x){return}if(u.origin!==location.origin||(u.pathname===location.pathname&&u.search===location.search)||!/^https?:$/.test(u.protocol))return;d.classList.add('is-loading')})})();";
const pageTitle = isHome ? 'Concepteur numérique, sites et interfaces — Antoine Bruneau' : `${title} — Antoine Bruneau`;

// Cloudflare sert les pages en /page/ (avec slash final) : le canonical suit cette forme.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;

const siteUrl = 'https://antoinebruneau.fr';
const ogImage = new URL(image, siteUrl).href;
const services = [
  { name: 'Création de site web', description: 'Conception et réalisation d’un site web : organisation des contenus, UX/UI, intégration (WordPress, Webflow ou code sur mesure), bases du référencement et mise en ligne.' },
  { name: 'Refonte de site web', description: 'Lecture de l’existant, corrections ciblées, refonte partielle ou complète, plan de redirection des anciennes adresses.' },
  { name: 'Conception d’interfaces et de logiciels', description: 'Conception UX/UI d’interfaces de logiciels métier, de produits SaaS et d’outils internes : parcours, prototypes, conception UI, design system, spécifications. Mission de conception ou renfort UX/UI.' },
  { name: 'Audit UX/UI', description: 'Revue experte d’un site ou d’une interface, accessibilité comprise avec les WCAG comme référentiel, constats et recommandations classées.' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${siteUrl}/#website`, url: siteUrl, name: 'Antoine Bruneau', inLanguage: 'fr-FR', publisher: { '@id': `${siteUrl}/#person` } },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#service`,
      name: 'Antoine Bruneau',
      url: siteUrl,
      email: 'contact@antoinebruneau.fr',
      telephone: '+33609111838',
      description: 'Concepteur numérique indépendant : conception et réalisation de sites web, conception UX/UI d’interfaces de logiciels métier, refonte et audit UX/UI, en Île-de-France et à distance partout en France.',
      founder: { '@id': `${siteUrl}/#person` },
      slogan: 'Mettez votre interface au travail.',
      image: ogImage,
      // Commune et code postal seulement (la rue figure dans les mentions légales) : de quoi situer l'activité sans exposer plus.
      address: { '@type': 'PostalAddress', addressLocality: 'Guitrancourt', postalCode: '78440', addressRegion: 'Île-de-France', addressCountry: 'FR' },
      identifier: { '@type': 'PropertyValue', propertyID: 'SIREN', value: '788566719' },
      knowsLanguage: 'fr',
      knowsAbout: [
        'Design UX/UI',
        'Conception d’interface',
        'Architecture de l’information',
        'Prototypage',
        'Design system',
        'Création de site web',
        'Refonte de site web',
        'Audit UX/UI',
        'Accessibilité numérique',
        'Développement front-end',
        'WordPress',
        'Webflow',
        'Référencement technique',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services',
        itemListElement: services.map((s) => ({ '@type': 'Service', name: s.name, description: s.description, provider: { '@id': `${siteUrl}/#service` }, serviceType: s.name })),
      },
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Île-de-France' },
        { '@type': 'Country', name: 'France' },
      ],
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'Antoine Bruneau',
      jobTitle: 'Concepteur numérique indépendant, UX/UI et développement front-end',
      description: 'Concepteur numérique indépendant depuis 2026. Formé à la Wild Code School (titre professionnel de concepteur UI), designer UX/UI pendant environ deux ans sur un logiciel SaaS de gestion de maintenance. Il conçoit et réalise des sites web et des interfaces de logiciels.',
      url: siteUrl,
      email: 'contact@antoinebruneau.fr',
      telephone: '+33609111838',
      worksFor: { '@id': `${siteUrl}/#service` },
      homeLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: 'Guitrancourt', postalCode: '78440', addressCountry: 'FR' } },
      knowsAbout: ['Design UX/UI', 'Conception d’interface', 'Architecture de l’information', 'Prototypage', 'Design system', 'Création de site web', 'Refonte de site web', 'Audit UX/UI', 'Accessibilité numérique', 'Développement front-end', 'WordPress', 'Webflow', 'Référencement technique'],
    },
  ],
};
// Le graphe commun (site, activité, personne) est publié sur TOUTES les pages : les références « @id » des pages (provider, isPartOf, about…)
// se résolvent ainsi dans le même document. La page décrit aussi ce qu'elle est (aide les moteurs et les assistants IA à la situer) ; les pages
// qui fournissent leur propre schéma (AboutPage, Service, ContactPage…) le font elles-mêmes.
if (!schema) {
  jsonLd['@graph'].push({
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: pageTitle,
    description,
    inLanguage: 'fr-FR',
    isPartOf: { '@id': `${siteUrl}/#website` },
    about: { '@id': `${siteUrl}/#service` },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
  });
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Antoine Bruneau" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="author" content="Antoine Bruneau" />
    <meta name="theme-color" content="#f5f3ea" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      // Seules les graisses du premier écran sont préchargées : le texte de l'en-tête (400 ou 500), ses boutons (600) et le titre (Bricolage Grotesque,
      // utilisé par le titre de chaque page). Les autres arrivent quand le CSS les demande ; d'ici là, la police de secours occupe exactement la même place (fonts.css).
      (isHome
        ? ['be-vietnam-pro-500', 'be-vietnam-pro-600', 'bricolage-grotesque-200-800']
        : ['be-vietnam-pro-400', 'be-vietnam-pro-500', 'be-vietnam-pro-600', 'bricolage-grotesque-200-800']
      ).map((f) => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />)
    }
    {isHome && <script is:inline set:html={"(function(){try{var d=document.documentElement;var q=location.search.indexOf(\"loader\")>-1;var rm=matchMedia(\"(prefers-reduced-motion: reduce)\").matches;var sm=matchMedia(\"(max-width: 700px)\").matches;if(!sm&&(q||(!rm&&!sessionStorage.getItem(\"ld\"))))d.classList.add(\"has-loader\")}catch(e){}})()"} />}
    {/* Le papier de la page et le grain de la Hero : préchargés en priorité sur ordinateur (le loader de l'accueil les attend). Sur téléphone,
        pas de loader : ils arrivent avec le CSS, sans passer devant le texte et les polices. */}
    <link rel="preload" href={stoneware} as="image" type="image/webp" fetchpriority="high" media="(min-width: 701px)" />
    <link rel="preload" href={filmGrain} as="image" type="image/webp" fetchpriority="high" media="(min-width: 701px)" />
    {/* Sur ordinateur, les textures des formes sont préchargées (priorité basse) : elles sont là quand on défile. Sur téléphone, aucune n'est
        préchargée : le CSS les demande quand il en a besoin, et la bande passante du premier écran va au texte et aux polices. */}
    {lateTextures.map((href) => <link rel="preload" href={href} as="image" type="image/webp" fetchpriority="low" media="(min-width: 701px)" />)}
    {/* Mode économe : machine modeste (≤ 4 coeurs, ≤ 4 Go, économiseur de données) ou jugée lente lors d'une visite précédente (site.js). */}
    <script is:inline set:html={"(function(){try{var n=navigator,c=n.connection;if(/Safari/.test(n.userAgent)&&!/Chrome|Chromium|CriOS|Android|Edg/.test(n.userAgent))document.documentElement.setAttribute('data-safari','');if(localStorage.getItem('perf')==='low'||(n.hardwareConcurrency&&n.hardwareConcurrency<=4)||(n.deviceMemory&&n.deviceMemory<=4)||(c&&c.saveData))document.documentElement.setAttribute('data-perf','low')}catch(e){}})()"} />
    <script is:inline set:html={textureGate} />
    {/* Serveur de développement seulement : sur une adresse partagée (tunnel ngrok, réseau local), la barre d'outils Astro est masquée ; en local
        (localhost, 127.0.0.1), elle reste disponible. N'existe pas dans la version construite. */}
    {import.meta.env.DEV && <script is:inline set:html={"(function(){var h=location.hostname;if(h==='localhost'||h==='127.0.0.1'||h==='[::1]')return;var s=document.createElement('style');s.textContent='astro-dev-toolbar{display:none!important}';document.head.appendChild(s)})()"} />}
    {/* le petit loader : un filet en haut de l'écran, pendant le chargement de la page et dès qu'on clique sur un lien interne (avant que l'écran ne change) */}
    <script is:inline set:html={navProgress} />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <div id="nav-progress" aria-hidden="true"></div>
    {isHome && <Loader />}
    <a class="skip-link" href="#main">Aller au contenu</a>
    <svg class="glass-defs" width="0" height="0" aria-hidden="true" focusable="false">
      {/* Bords légèrement rongés pour les tracés faits main (voir Mark.astro) */}
      <filter id="ink" x="-10%" y="-30%" width="120%" height="160%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.035 0.06" numOctaves="2" seed="3" result="grit" />
        <feDisplacementMap in="SourceGraphic" in2="grit" scale="3.2" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      {/* Légère irrégularité du geste : le trait se courbe très doucement, comme une main qui n'est jamais tout à fait droite */}
      <filter id="wobble" x="-2%" y="-80%" width="104%" height="260%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.0045 0.012" numOctaves="2" seed="7" result="bend" />
        <feDisplacementMap in="SourceGraphic" in2="bend" scale="9" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/site.js"></script>
  </body>
</html>
