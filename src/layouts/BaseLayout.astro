---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/sections.css';
import '../styles/glass.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: object;
  /** Image de partage (chemin depuis la racine) */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  noindex = false,
  schema,
  image = '/og-image.jpg',
  imageAlt = 'Antoine Bruneau, webdesigner et designer UX/UI freelance dans les Yvelines : « Votre site, avec du caractère. »',
} = Astro.props;
const isHome = Astro.url.pathname === '/';
const pageTitle = isHome ? 'Webdesigner UX/UI freelance, Yvelines — Antoine Bruneau' : `${title} — Antoine Bruneau`;

// Cloudflare sert les pages en /page/ (avec slash final) : le canonical suit cette forme.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;

const siteUrl = 'https://antoinebruneau.fr';
const ogImage = new URL(image, siteUrl).href;
const services = [
  { name: 'Création de site web', description: 'Conception sur mesure : structure, maquettes, intégration, bases du référencement et mise en ligne.' },
  { name: 'Refonte de site web', description: 'Audit de l’existant, puis refonte de ce qui doit l’être, avec un tarif préférentiel pour le pack audit + conception.' },
  { name: 'Audit UX/UI', description: 'Analyse d’un site ou d’une interface, problèmes classés par priorité avec recommandations.' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${siteUrl}/#website`, url: siteUrl, name: 'Antoine Bruneau', inLanguage: 'fr-FR' },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#service`,
      name: 'Antoine Bruneau',
      url: siteUrl,
      email: 'contact@antoinebruneau.fr',
      telephone: '+33609111838',
      description: 'Webdesigner et designer UX/UI freelance : création de site, refonte de site et audit UX/UI, dans les Yvelines et à distance partout en France.',
      founder: { '@id': `${siteUrl}/#person` },
      description: 'Webdesigner et designer UX/UI freelance : création de site, refonte de site et audit UX/UI, dans les Yvelines et à distance partout en France.',
      slogan: 'Votre site, avec du caractère.',
      image: ogImage,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services',
        itemListElement: services.map((s) => ({ '@type': 'Service', name: s.name, description: s.description, provider: { '@id': `${siteUrl}/#service` }, serviceType: s.name })),
      },
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Yvelines' },
        { '@type': 'AdministrativeArea', name: "Val-d'Oise" },
        { '@type': 'AdministrativeArea', name: 'Oise' },
        { '@type': 'AdministrativeArea', name: 'Paris' },
        { '@type': 'AdministrativeArea', name: 'Île-de-France' },
        { '@type': 'Country', name: 'France' },
      ],
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'Antoine Bruneau',
      jobTitle: 'Designer UX/UI et webdesigner freelance',
      url: siteUrl,
      email: 'contact@antoinebruneau.fr',
      telephone: '+33609111838',
    },
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Antoine Bruneau" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="author" content="Antoine Bruneau" />
    <meta name="theme-color" content="#f5f3ea" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      [
        'be-vietnam-pro-400',
        'be-vietnam-pro-500',
        'be-vietnam-pro-600',
        'be-vietnam-pro-700',
        ...(isHome ? ['bricolage-grotesque-200-800'] : []),
      ].map((f) => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />)
    }
    {isHome && <script is:inline set:html={"(function(){try{var d=document.documentElement;var q=location.search.indexOf(\"loader\")>-1;var rm=matchMedia(\"(prefers-reduced-motion: reduce)\").matches;if(q||(!rm&&!sessionStorage.getItem(\"ld\")))d.classList.add(\"has-loader\")}catch(e){}})()"} />}
    <slot name="head" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    {isHome && <Loader />}
    <a class="skip-link" href="#main">Aller au contenu</a>
    <svg class="glass-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="liquid-glass" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.009 0.014" numOctaves="2" seed="7" result="noise" />
        <feGaussianBlur in="noise" stdDeviation="3" result="softNoise" />
        <feDisplacementMap in="SourceGraphic" in2="softNoise" scale="30" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <!-- Version très légère du même principe, pour une distorsion à peine
           perceptible sur le verre de la navbar (pas le "melty" du CTA). -->
      <filter id="glass-distort" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.012 0.02" numOctaves="2" seed="4" result="noise" />
        <feGaussianBlur in="noise" stdDeviation="2" result="softNoise" />
        <feDisplacementMap in="SourceGraphic" in2="softNoise" scale="7" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <!-- Bords légèrement rongés pour les tracés faits main (voir Mark.astro) -->
      <filter id="ink" x="-10%" y="-30%" width="120%" height="160%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.035 0.06" numOctaves="2" seed="3" result="grit" />
        <feDisplacementMap in="SourceGraphic" in2="grit" scale="3.2" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <!-- Légère irrégularité du geste : le trait se courbe très doucement, comme une main qui n'est jamais tout à fait droite -->
      <filter id="wobble" x="-2%" y="-80%" width="104%" height="260%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.0045 0.012" numOctaves="2" seed="7" result="bend" />
        <feDisplacementMap in="SourceGraphic" in2="bend" scale="9" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/site.js"></script>
  </body>
</html>
