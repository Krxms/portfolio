---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/textures.css';
import '../styles/textures-hd.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/glass.css';
import '../styles/cta.css';
import '../styles/motion.css';
import '../styles/matiere.css';
import '../styles/mobile-heads.css';
import '../styles/perf.css';
// Les textures de la Hero (béton, mouchetures, grès). Importées en « ?url » : même fichier, même nom (avec empreinte) que dans les CSS.
import concreteZoom from '../assets/riso/concrete-zoom.webp?url';
import filmGrain from '../assets/riso/film-grain.webp?url';
import stoneware from '../assets/riso/stoneware.webp?url';
import grain from '../assets/riso/grain.webp?url';
import { lastModified } from '../../tools/lastmod.mjs';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: object;
  /** Image de partage (chemin depuis la racine) */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  noindex = false,
  schema,
  image = '/og-image.jpg',
  imageAlt = 'Antoine Bruneau, concepteur numérique indépendant : sites web, interfaces et logiciels.',
} = Astro.props;
const isHome = Astro.url.pathname === '/';
// Les textures de la Hero et des formes (béton, mouchetures, grès, grain), préchargées sur ordinateur. Les deux grains fins des panneaux bleus
// (grain-soft, speck) sont, eux, intégrés au CSS en base 64 : ils sont là dès la première image, sans requête. Rien n'est caché en attendant une texture :
// la page s'affiche dès que le HTML, le CSS et les polices sont là, et la matière s'y pose à son arrivée.
// Critiques : le papier de la page et le grain de la Hero. Secondaires : les textures des formes, en priorité basse pour ne pas retarder le CSS, les polices ni le texte.
const lateTextures = [concreteZoom, grain];
// Le filet de chargement (#nav-progress, global.css) et la pose des textures définitives (classe tx-in). Script placé juste après le filet :
//  Les classes sont posées sur le filet lui-même, pas sur <html> : changer une classe de <html> ferait recalculer les styles de toute la page.
//  - chargement de la page : le filet ne s'anime qu'une fois l'élément dessiné (requestAnimationFrame), et ne devient visible qu'après un court délai
//    (CSS) : une page qui s'affiche vite ne le montre jamais. Il se termine quand le texte est prêt (DOMContentLoaded et polices), pas à la fin du
//    téléchargement des images : la page est lisible, il n'y a plus rien à attendre ;
//  - clic sur un lien interne : il repart aussitôt, avant que l'écran ne change ; la page suivante prend le relais ;
//  - tx-in : posée après le premier grand affichage (LCP) ou au plus tard 3 s après le chargement ; elle déclenche les textures haute définition et les
//    polices secondaires (italique, Inter), qui n'ont pas à passer devant le premier écran.
const navProgress = `(function(){
var d=document.documentElement,b=document.getElementById('nav-progress'),done=false,t;
function start(){clearTimeout(t);b.classList.remove('is-done');b.classList.add('is-loading')}
function finish(){if(done)return;done=true;if(!b.classList.contains('is-loading'))return;b.classList.remove('is-loading');b.classList.add('is-done');t=setTimeout(function(){b.classList.remove('is-done')},700)}
if(document.readyState==='loading'){requestAnimationFrame(function(){if(!done)start()});document.addEventListener('DOMContentLoaded',function(){var f=document.fonts&&document.fonts.ready;(f?Promise.race([f,new Promise(function(r){setTimeout(r,1500)})]):Promise.resolve()).then(finish)})}else{done=true}
var on=false;function go(){if(on)return;on=true;d.classList.add('tx-in');var s=document.createElement('style');s.textContent="@font-face{font-family:'Be Vietnam Pro';font-style:italic;font-weight:400;font-display:swap;src:url('/fonts/be-vietnam-pro-400-italic.woff2') format('woff2')}@font-face{font-family:'Inter';font-style:normal;font-weight:100 900;font-display:swap;src:url('/fonts/inter-variable.woff2') format('woff2')}";document.head.appendChild(s)}
addEventListener('load',function(){if(document.querySelector('.er-code'))go();setTimeout(go,3000);try{new PerformanceObserver(function(l,o){o.disconnect();setTimeout(go,300)}).observe({type:'largest-contentful-paint',buffered:true})}catch(e){setTimeout(go,600)}});
addEventListener('pageshow',function(e){if(e.persisted){clearTimeout(t);b.classList.remove('is-loading','is-done');d.classList.add('tx-in')}});
document.addEventListener('click',function(e){var a=e.target&&e.target.closest&&e.target.closest('a[href]');if(!a||e.defaultPrevented||e.button||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey||(a.target&&a.target!=='_self')||a.hasAttribute('download'))return;var u;try{u=new URL(a.href,location.href)}catch(x){return}if(u.origin!==location.origin||(u.pathname===location.pathname&&u.search===location.search)||!/^https?:$/.test(u.protocol))return;start()});
})();`;
const pageTitle = isHome ? 'Concepteur numérique, sites et interfaces — Antoine Bruneau' : `${title} — Antoine Bruneau`;

// Cloudflare sert les pages en /page/ (avec slash final) : le canonical suit cette forme.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;
// Pages d'erreur (404 et /erreurs/<code>/) : servies sous l'adresse demandée, elles n'ont pas d'adresse propre à déclarer (ni canonical ni og:url).
const isError = /^\/(404|erreurs)(\/|$)/.test(Astro.url.pathname);

const siteUrl = 'https://antoinebruneau.fr';
const ogImage = new URL(image, siteUrl).href;
const services = [
  { name: 'Création de site web', description: 'Conception et réalisation d’un site web : organisation des contenus, UX/UI, intégration (WordPress, Webflow ou code sur mesure), bases du référencement et mise en ligne.' },
  { name: 'Refonte de site web', description: 'Lecture de l’existant, corrections ciblées, refonte partielle ou complète, plan de redirection des anciennes adresses.' },
  { name: 'Conception d’interfaces et de logiciels', description: 'Conception UX/UI d’interfaces de logiciels métier, de produits SaaS et d’outils internes : parcours, prototypes, conception UI, design system, spécifications. Mission de conception ou renfort UX/UI.' },
  { name: 'Audit UX/UI', description: 'Revue experte d’un site ou d’une interface, accessibilité comprise avec les WCAG comme référentiel, constats et recommandations classées.' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Antoine Bruneau',
      description: 'Site d’Antoine Bruneau, concepteur numérique indépendant : création et refonte de sites web, conception UX/UI d’interfaces et de logiciels, audit UX/UI.',
      inLanguage: 'fr-FR',
      publisher: { '@id': `${siteUrl}/#person` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#service`,
      name: 'Antoine Bruneau',
      url: siteUrl,
      email: 'contact@antoinebruneau.fr',
      telephone: '+33609111838',
      description: 'Concepteur numérique indépendant : conception et réalisation de sites web, conception UX/UI d’interfaces de logiciels métier, refonte et audit UX/UI, en Île-de-France et à distance partout en France.',
      founder: { '@id': `${siteUrl}/#person` },
      slogan: 'Mettez votre interface au travail.',
      image: ogImage,
      // Commune et code postal seulement (la rue figure dans les mentions légales) : de quoi situer l'activité sans exposer plus.
      address: { '@type': 'PostalAddress', addressLocality: 'Guitrancourt', postalCode: '78440', addressRegion: 'Île-de-France', addressCountry: 'FR' },
      identifier: { '@type': 'PropertyValue', propertyID: 'SIREN', value: '788566719' },
      knowsLanguage: 'fr',
      contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', email: 'contact@antoinebruneau.fr', telephone: '+33609111838', availableLanguage: 'fr', url: `${siteUrl}/contact/` },
      knowsAbout: [
        'Design UX/UI',
        'Conception d’interface',
        'Architecture de l’information',
        'Prototypage',
        'Design system',
        'Création de site web',
        'Refonte de site web',
        'Audit UX/UI',
        'Accessibilité numérique',
        'Développement front-end',
        'WordPress',
        'Webflow',
        'Référencement technique',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services',
        itemListElement: services.map((s) => ({ '@type': 'Service', name: s.name, description: s.description, provider: { '@id': `${siteUrl}/#service` }, serviceType: s.name })),
      },
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Île-de-France' },
        { '@type': 'Country', name: 'France' },
      ],
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'Antoine Bruneau',
      jobTitle: 'Concepteur numérique indépendant, UX/UI et développement front-end',
      description: 'Concepteur numérique indépendant depuis 2026. Formé à la Wild Code School (titre professionnel de concepteur UI), designer UX/UI pendant environ deux ans sur un logiciel SaaS de gestion de maintenance. Il conçoit et réalise des sites web et des interfaces de logiciels.',
      url: siteUrl,
      email: 'contact@antoinebruneau.fr',
      telephone: '+33609111838',
      worksFor: { '@id': `${siteUrl}/#service` },
      alumniOf: { '@type': 'EducationalOrganization', name: 'Wild Code School' },
      knowsLanguage: 'fr',
      homeLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: 'Guitrancourt', postalCode: '78440', addressCountry: 'FR' } },
      knowsAbout: ['Design UX/UI', 'Conception d’interface', 'Architecture de l’information', 'Prototypage', 'Design system', 'Création de site web', 'Refonte de site web', 'Audit UX/UI', 'Accessibilité numérique', 'Développement front-end', 'WordPress', 'Webflow', 'Référencement technique'],
    },
  ],
};
// Le graphe commun (site, activité, personne) est publié sur TOUTES les pages : les références « @id » des pages (provider, isPartOf, about…)
// se résolvent ainsi dans le même document. Chaque page décrit aussi ce qu'elle est (aide les moteurs et les assistants IA à la situer) :
// les pages qui déclarent déjà leur nœud de page (AboutPage, ContactPage…) le gardent ; sinon (accueil, offres, projet, pages légales), un WebPage
// est ajouté, avec pour sujet principal le service ou l'étude de cas de la page quand elle en a un.
const modified = lastModified(path);
const pageNodes: any[] = schema ? ((schema as any)['@graph'] ?? [schema]) : [];
const ownPage = pageNodes.find((n) => /Page$/.test(n['@type']) && n['@type'] !== 'FAQPage');
if (ownPage) {
  if (modified && !ownPage.dateModified) ownPage.dateModified = modified;
} else if (!isError) {
  const subject = pageNodes.find((n) => (n['@type'] === 'Service' || n['@type'] === 'CreativeWork') && n['@id']);
  jsonLd['@graph'].push({
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: pageTitle,
    description,
    inLanguage: 'fr-FR',
    isPartOf: { '@id': `${siteUrl}/#website` },
    about: { '@id': `${siteUrl}/#service` },
    ...(subject ? { mainEntity: { '@id': subject['@id'] } } : {}),
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
    ...(modified ? { dateModified: modified } : {}),
  });
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!isError && <link rel="canonical" href={canonical} />}
    {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!isError && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Antoine Bruneau" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="author" content="Antoine Bruneau" />
    <meta name="theme-color" content="#f5f3ea" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      // Toutes les graisses du texte du site sont préchargées (400, 500, 600, 700 et Bricolage Grotesque) : elles arrivent avec le CSS. En attendant, le texte
      // s'affiche aussitôt dans une police de secours calée sur leurs mesures (font-display: swap, fonts.css) : rien ne bouge à l'échange.
      ['be-vietnam-pro-400', 'be-vietnam-pro-500', 'be-vietnam-pro-600', 'be-vietnam-pro-700', 'bricolage-grotesque-200-800'].map((f) => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />)
    }
    {/* Le papier de la page et le grain de la Hero : préchargés en priorité sur ordinateur. Sur téléphone, ils arrivent avec le CSS, sans passer
        devant le texte et les polices. */}
    <link rel="preload" href={stoneware} as="image" type="image/webp" fetchpriority="high" media="(min-width: 701px)" />
    <link rel="preload" href={filmGrain} as="image" type="image/webp" fetchpriority="high" media="(min-width: 701px)" />
    {/* Sur ordinateur, les textures des formes sont préchargées (priorité basse) : elles sont là quand on défile. Sur téléphone, aucune n'est
        préchargée : le CSS les demande quand il en a besoin, et la bande passante du premier écran va au texte et aux polices. */}
    {lateTextures.map((href) => <link rel="preload" href={href} as="image" type="image/webp" fetchpriority="low" media="(min-width: 701px)" />)}
    {/* Mode économe (perf.css) : seulement à la demande explicite du visiteur (économiseur de données du navigateur) ou en test (localStorage « perf-force » = « low »). Plus de détection automatique : elle retirait le verre et les textures sur des machines tout à fait capables. */}
    <script is:inline set:html={"(function(){try{var n=navigator,c=n.connection;if(/Safari/.test(n.userAgent)&&!/Chrome|Chromium|CriOS|Android|Edg/.test(n.userAgent))document.documentElement.setAttribute('data-safari','');if(localStorage.getItem('perf-force')==='low'||(c&&c.saveData))document.documentElement.setAttribute('data-perf','low')}catch(e){}})()"} />
    {/* Serveur de développement seulement : sur une adresse partagée (tunnel ngrok, réseau local), la barre d'outils Astro est masquée ; en local
        (localhost, 127.0.0.1), elle reste disponible. N'existe pas dans la version construite. */}
    {import.meta.env.DEV && <script is:inline set:html={"(function(){var h=location.hostname;if(h==='localhost'||h==='127.0.0.1'||h==='[::1]')return;var s=document.createElement('style');s.textContent='astro-dev-toolbar{display:none!important}';document.head.appendChild(s)})()"} />}
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    {/* le filet de chargement en haut de l'écran : visible seulement si un chargement dure (voir navProgress plus haut et global.css) */}
    <div id="nav-progress" aria-hidden="true"></div>
    <script is:inline set:html={navProgress} />
    <a class="skip-link" href="#main">Aller au contenu</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/site.js"></script>
  </body>
</html>
