  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "section": "72 à 136 (clamp)" },
  "radius": { "sm": 10, "md": 18, "lg": 32, "btn": 12, "panel": 44, "pill": 999 },
