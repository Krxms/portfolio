  "typography": {
    "family": { "display": "Bricolage Grotesque", "body": "Be Vietnam Pro" },
    "styles": {
      "Display/Hero": { "family": "display", "weight": 700, "size": 88, "lineHeight": 86, "letterSpacing": "-4%" },
      "Heading/H1": { "family": "display", "weight": 600, "size": 64, "lineHeight": 66, "letterSpacing": "-3%" },
      "Heading/H2": { "family": "display", "weight": 600, "size": 56, "lineHeight": 58, "letterSpacing": "-3%" },
      "Heading/H3": { "family": "display", "weight": 600, "size": 28, "lineHeight": 32, "letterSpacing": "-2%" },
      "Body/Lead": { "family": "body", "weight": 400, "size": 22, "lineHeight": 33 },
      "Body/Base": { "family": "body", "weight": 400, "size": 17, "lineHeight": 27 },
      "Body/Small": { "family": "body", "weight": 400, "size": 15, "lineHeight": 24 },
      "Label/Eyebrow": { "family": "body", "weight": 600, "size": 13, "lineHeight": 18, "letterSpacing": "4%", "case": "upper" },
      "Label/Button": { "family": "body", "weight": 600, "size": 17, "lineHeight": 22 },
      "Caption/Base": { "family": "body", "weight": 500, "size": 12, "lineHeight": 18 }
    }
  },
  "migration": {
    "--signal": "primitives.cerulean.600 (rôle action/primary)",
    "--signal-deep": "primitives.cerulean.800 (rôle focus/ring)",
    "--ink": "primitives.ink.900",
    "--paper": "primitives.paper.base",
    "--mark": "primitives.corail.500 (#F16141, coral du logo)",
    "--cream": "primitives.cream.200",
    "#86e6d8 / #d6f1e8": "retirés des accents d'interface (menthe réservée aux illustrations)"
  }
