  "semantic": {
    "$modes": ["clair", "sombre"],
    "surface/page": ["paper/base", "klein/950"],
    "surface/alt": ["paper/mist", "klein/900"],
    "surface/cool": ["paper/cool", "klein/900"],
    "surface/card": ["paper/card", "klein/800"],
    "surface/inverse": ["klein/950", "paper/base"],
    "surface/glass": ["rgba(255,254,250,0.55)", "rgba(23,43,133,0.55)"],
    "surface/glass-hover": ["rgba(255,254,250,0.85)", "rgba(23,43,133,0.80)"],
    "surface/tint": ["rgba(18,32,43,0.07)", "rgba(255,255,255,0.12)"],
    "text/primary": ["ink/900", "paper/white"],
    "text/secondary": ["ink/700", "ink/100"],
    "text/muted": ["ink/600", "ink/300"],
    "text/accent": ["cerulean/600", "cream/200"],
    "text/accent-warm": ["corail/600", "corail/300"],
    "text/on-action": ["paper/white", "ink/900"],
    "text/on-action-hover": ["ink/900", "ink/900"],
    "border/default": ["ink/200", "klein/700"],
    "border/strong": ["ink/300", "klein/600"],
    "border/tint": ["rgba(18,32,43,0.14)", "rgba(255,255,255,0.18)"],
    "action/primary": ["cerulean/600", "paper/white"],
    "action/primary-hover": ["cream/200", "cream/200"],
    "action/secondary-border": ["cerulean/600", "paper/white"],
    "focus/ring": ["cerulean/800", "paper/white"],
    "feedback/danger": ["status/danger", "corail/300"],
    "feedback/ok": ["status/ok", "mint/300"],
    "brand/lava-1": ["klein/600", "klein/500"],
    "brand/lava-2": ["lagoon/500", "lagoon/400"],
    "brand/lava-3": ["violet/500", "violet/400"],
    "brand/lava-4": ["orchid/500", "orchid/300"],
    "brand/mark": ["corail/500", "corail/300"]
