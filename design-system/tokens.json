    "lagoon": { "50": "#ECF8FB", "100": "#D1EEF5", "200": "#A3DCEB", "300": "#6CC4DC", "400": "#3DAAC9", "500": "#1F94BF", "600": "#1A7AA0", "700": "#166080", "800": "#124A63", "900": "#0D3548" },
    "mint": { "100": "#D6F1E8", "300": "#86E6D8", "500": "#27B3A3" },
    "violet": { "50": "#F1EEFD", "100": "#E1DBFB", "200": "#C4B8F6", "300": "#A190F0", "400": "#836CE8", "500": "#6B4DE0", "600": "#5638BF", "700": "#432D96", "800": "#2A1C70", "900": "#1C1350" },
    "orchid": { "300": "#CDA3EE", "500": "#9E5CDB" },
    "cream": { "50": "#FFFBEA", "100": "#FFF6CF", "200": "#FFF0B3", "300": "#FFE48A", "400": "#F1C14F", "500": "#F5A02A" },
    "corail": { "200": "#FFD9C4", "300": "#FFB48A", "500": "#F16141", "600": "#B83F25" },
    "status": { "danger": "#9B1C1C", "ok": "#3D6A4B" }
